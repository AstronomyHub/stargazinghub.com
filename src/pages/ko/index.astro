---
import Layout from '../../layouts/Layout.astro';
import HomeLanding from '../../components/home/HomeLanding.astro';
import { translations } from '../../i18n/ui';

const lang = 'ko';
const t = translations[lang];
---

<Layout title={t.meta?.title || 'Stargazing Hub: 별 지도, 광공해 지도와 오로라 예보'} lang={lang} description={t.meta?.description}>
  <HomeLanding t={t} lang={lang} />
</Layout>
