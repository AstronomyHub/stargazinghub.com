---
import Layout from '../../layouts/Layout.astro';
import HomeLanding from '../../components/home/HomeLanding.astro';
import { translations } from '../../i18n/ui';

const lang = 'zh-tw';
const t = translations[lang];
---

<Layout title={t.meta?.title || '天文通：星圖、光污染、極光預報與觀星指數'} lang={lang} description={t.meta?.description}>
  <HomeLanding t={t} lang={lang} />
</Layout>
