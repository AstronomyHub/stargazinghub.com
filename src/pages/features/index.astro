---
import Layout from '../../layouts/Layout.astro';
import ContentDownload from '../../components/ContentDownload.astro';
import StoreLinks from '../../components/home/StoreLinks.astro';
import Footer from '../../components/Footer.astro';
import { downloadLinks, featurePages, siteUrl } from '../../data/appKnowledge';
import { translations } from '../../i18n/ui';

const t = translations.en;
const contentReviewedAt = '2026-08-10';
const pageUrl = new URL('/features/', siteUrl).toString();
const formattedUpdatedAt = new Intl.DateTimeFormat('en', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
}).format(new Date(`${contentReviewedAt}T00:00:00Z`));

const spotlightSlugs = ['light-pollution-map', 'stargazing-forecast', 'sky-map', 'sky-recognition'];
const spotlightFeatures = spotlightSlugs
  .map((slug) => featurePages.find((feature) => feature.slug === slug))
  .filter((feature): feature is (typeof featurePages)[number] => Boolean(feature));
const supportingFeatures = featurePages.filter((feature) => !spotlightSlugs.includes(feature.slug));

const spotlightMedia: Record<string, { src: string; alt: string }> = {
  'stargazing-forecast': {
    src: '/press/stargazinghub-observing-forecast.webp',
    alt: 'Stargazing Hub observing forecast with stargazing index and hourly conditions',
  },
  'sky-map': {
    src: '/press/stargazinghub-star-chart.webp',
    alt: 'Stargazing Hub star chart with constellations and sky map controls',
  },
  'light-pollution-map': {
    src: '/press/stargazinghub-light-pollution-map.webp',
    alt: 'Stargazing Hub light pollution map for comparing observing locations',
  },
  'sky-recognition': {
    src: '/press/stargazinghub-sky-recognition.webp',
    alt: 'Stargazing Hub sky recognition result for a night sky photo',
  },
};

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Stargazing Hub Features',
    description: 'Sky map, stargazing forecast, light pollution map, sky recognition, aurora, Moon, meteor and astrophotography features in Stargazing Hub.',
    url: pageUrl,
    dateModified: contentReviewedAt,
    hasPart: featurePages.map((feature) => ({
      '@type': 'WebPage',
      name: feature.title,
      url: new URL(`/features/${feature.slug}/`, siteUrl).toString(),
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Stargazing Hub features',
    itemListElement: featurePages.map((feature, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: feature.title,
      url: new URL(`/features/${feature.slug}/`, siteUrl).toString(),
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: siteUrl,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Features',
        item: pageUrl,
      },
    ],
  },
];
---

<Layout
  title="Stargazing Hub Features | Plan, Observe and Photograph the Night Sky"
  description="Stargazing Hub features for sky mapping, astronomy weather, light pollution, sky photo recognition, aurora, the Moon, meteor showers and astrophotography."
  image="/press/stargazinghub-observing-forecast.webp"
  lang="en"
  structuredData={structuredData}
>
  <main class="sg-subpage feature-index">
    <section class="sg-subpage-hero">
      <div class="sg-shell">
        <nav aria-label="Breadcrumb" class="sg-breadcrumb">
          <ol class="flex items-center gap-2 text-sm text-[var(--text-muted)]">
            <li><a href="/" class="transition-colors hover:text-white">Stargazing Hub</a></li>
            <li aria-hidden="true">/</li>
            <li class="text-[var(--text-secondary)]" aria-current="page">Features</li>
          </ol>
        </nav>

        <div class="sg-index-intro night-reveal">
          <h1 class="sg-subpage-title">Plan your night. Know your sky.</h1>
          <p class="sg-subpage-lead">
            Check tonight's conditions, compare observing sites, preview the sky and match the frame to your equipment.
          </p>
          <StoreLinks t={t} placement="features-hero" />
          <p class="sg-reviewed">
            Feature information reviewed <time datetime={contentReviewedAt}>{formattedUpdatedAt}</time>
          </p>
        </div>
      </div>
    </section>

    <section class="sg-subpage-section">
      <div class="sg-shell">
        <div class="mb-9 max-w-2xl">
          <h2 class="text-3xl sm:text-4xl">Start with a place and a forecast</h2>
          <p class="mt-3 leading-relaxed text-[var(--text-secondary)]">Compare dark-sky locations, check the clouds, then explore what is overhead.</p>
        </div>

        <div class="feature-catalog">
          {spotlightFeatures.map((feature, index) => {
            const media = spotlightMedia[feature.slug];

            if (!media) {
              return null;
            }

            return (
              <article class="sg-feature-tile overflow-hidden">
                <a href={`/features/${feature.slug}/`} class="group no-underline">
                  <div class="feature-tile-copy">
                    <h3 class="text-2xl font-semibold text-white sm:text-3xl">{feature.shortTitle}</h3>
                    <p class="mt-4 flex-1 leading-relaxed text-[var(--text-secondary)]">{feature.metaDescription}</p>
                    <span class="mt-7 text-sm font-medium text-[var(--sg-accent)]" aria-hidden="true">→</span>
                  </div>
                  <div class="feature-tile-media">
                    <img
                      src={media.src}
                      alt={media.alt}
                      width="1080"
                      height="1920"
                      class="h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.03]"
                      loading={index < 2 ? 'eager' : 'lazy'}
                      decoding="async"
                    />
                  </div>
                </a>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <section class="sg-subpage-section">
      <div class="sg-shell border-y border-white/10 py-14">
        <div class="grid gap-10 lg:grid-cols-12">
          <div class="lg:col-span-4">
            <h2 class="text-3xl sm:text-4xl">More tools in the app</h2>
            <p class="mt-4 leading-relaxed text-[var(--text-secondary)]">Check Moon details, meteor showers, aurora conditions and astrophotography calculations.</p>
          </div>

          <div class="lg:col-span-7 lg:col-start-6">
            {supportingFeatures.map((feature) => (
              <a
                href={`/features/${feature.slug}/`}
                class="group flex items-start justify-between gap-6 border-t border-white/10 py-6 no-underline first:border-t-0 first:pt-0"
              >
                <span>
                  <span class="block text-xl font-semibold text-white">{feature.shortTitle}</span>
                  <span class="mt-2 block text-sm leading-relaxed text-[var(--text-muted)]">{feature.metaDescription}</span>
                </span>
                <span class="mt-1 shrink-0 text-[var(--text-muted)] transition-transform group-hover:translate-x-1 group-hover:text-white" aria-hidden="true">→</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <ContentDownload placement="features" />
  </main>
  <Footer t={t} lang="en" />
</Layout>

<style>
  @media (max-width: 768px) {
    .feature-index :global(section),
    .feature-index :global(div),
    .feature-index :global(p),
    .feature-index :global(h1),
    .feature-index :global(h2),
    .feature-index :global(h3) {
      word-break: normal;
      hyphens: none;
    }
  }
</style>
