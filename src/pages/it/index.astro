---
import Layout from '../../layouts/Layout.astro';
import HomeLanding from '../../components/home/HomeLanding.astro';
import { translations } from '../../i18n/ui';

const lang = 'it';
const t = translations[lang];
---

<Layout title={t.meta?.title || 'Stargazing Hub: mappa del cielo, inquinamento luminoso e aurore'} lang={lang} description={t.meta?.description}>
  <HomeLanding t={t} lang={lang} />
</Layout>
