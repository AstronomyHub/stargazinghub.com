---
import Layout from '../layouts/Layout.astro';
import ContentDownload from '../components/ContentDownload.astro';
import Footer from '../components/Footer.astro';
import { downloadLinks, faqItems, siteUrl } from '../data/appKnowledge';
import { translations } from '../i18n/ui';

const t = translations.en;
const contentReviewedAt = '2026-08-10';
const pageUrl = new URL('/faq/', siteUrl).toString();
const formattedUpdatedAt = new Intl.DateTimeFormat('en', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
}).format(new Date(`${contentReviewedAt}T00:00:00Z`));

const answerLinks = [
  { href: '/features/', label: 'Compare all app features' },
  { href: '/features/light-pollution-map/', label: 'Read about the light pollution map' },
  { href: '/features/sky-recognition/', label: 'See how sky recognition works' },
  { href: '/features/astrophotography-tools/', label: 'Read about astrophotography tools' },
  { href: '/features/aurora-forecast/', label: 'Read about the aurora forecast' },
  { href: '/features/', label: 'Browse the full feature guide' },
];

const relatedFeatures = [
  { href: '/features/stargazing-forecast/', title: 'Stargazing Forecast', detail: 'Clouds, seeing, transparency, Moon and hourly observing conditions.' },
  { href: '/features/sky-map/', title: 'Sky Map', detail: 'Preview the visible sky for a selected place and time.' },
  { href: '/features/light-pollution-map/', title: 'Light Pollution Map', detail: 'Compare locations before making a dark-sky trip.' },
  { href: '/features/astrophotography-tools/', title: 'Astrophotography Tools', detail: 'Plan framing, equipment combinations and mosaics.' },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    name: 'Stargazing Hub FAQ',
    url: pageUrl,
    dateModified: contentReviewedAt,
    mainEntity: faqItems.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: siteUrl,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'FAQ',
        item: pageUrl,
      },
    ],
  },
];
---

<Layout
  title="Stargazing Hub FAQ | Features, Pricing and Planning"
  description="Answers about Stargazing Hub pricing, light pollution maps, sky photo recognition, aurora planning, astrophotography tools and supported languages."
  lang="en"
  markdownUrl="/faq.md"
  structuredData={structuredData}
>
  <main class="sg-subpage faq-page">
    <section class="sg-subpage-hero">
      <div class="sg-shell">
        <nav aria-label="Breadcrumb" class="sg-breadcrumb">
          <ol class="flex items-center gap-2 text-sm text-[var(--text-muted)]">
            <li><a href="/" class="transition-colors hover:text-white">Stargazing Hub</a></li>
            <li aria-hidden="true">/</li>
            <li class="text-[var(--text-secondary)]" aria-current="page">FAQ</li>
          </ol>
        </nav>

        <div class="sg-index-intro night-reveal">
          <h1 class="sg-subpage-title">Stargazing Hub FAQ</h1>
          <p class="sg-subpage-lead">
            Pricing, supported devices, languages and the main astronomy features.
          </p>
        </div>
      </div>
    </section>

    <section class="sg-subpage-section">
      <div class="sg-shell grid gap-12 lg:grid-cols-12 lg:gap-16">
        <aside class="lg:col-span-3">
          <div class="lg:sticky lg:top-24">
            <h2 class="text-2xl">Quick navigation</h2>
            <nav aria-label="FAQ questions" class="mt-5">
              <ol class="space-y-3 text-sm text-[var(--text-muted)]">
                {faqItems.map((item, index) => (
                  <li><a href={`#question-${index + 1}`} class="leading-relaxed transition-colors hover:text-white">{item.question}</a></li>
                ))}
              </ol>
            </nav>
          </div>
        </aside>

        <div class="lg:col-span-8 lg:col-start-5">
          {faqItems.map((item, index) => {
            const answerLink = answerLinks[index];

            return (
              <details id={`question-${index + 1}`} class="faq-question" open={index === 0}>
                <summary><h2>{item.question}</h2><span aria-hidden="true">+</span></summary>
                <div class="faq-answer">
                  <p>{item.answer}</p>
                  {answerLink && <a href={answerLink.href} class="sg-inline-link mt-5 inline-block">{answerLink.label} →</a>}
                </div>
              </details>
            );
          })}
          <p class="sg-reviewed">Answers reviewed <time datetime={contentReviewedAt}>{formattedUpdatedAt}</time></p>
        </div>
      </div>
    </section>

    <section class="sg-subpage-section">
      <div class="sg-shell border-y border-white/10 py-14">
        <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
          <div>
            <h2 class="text-3xl sm:text-4xl">Feature guides</h2>
          </div>
          <a href="/features/" class="sg-inline-link">View all features →</a>
        </div>

        <div class="grid gap-x-10 md:grid-cols-2">
          {relatedFeatures.map((feature) => (
            <a href={feature.href} class="group flex items-start justify-between gap-6 border-t border-white/10 py-6 no-underline">
              <span>
                <span class="block text-xl font-semibold text-white">{feature.title}</span>
                <span class="mt-2 block text-sm leading-relaxed text-[var(--text-muted)]">{feature.detail}</span>
              </span>
              <span class="mt-1 shrink-0 text-[var(--text-muted)] transition-transform group-hover:translate-x-1 group-hover:text-white" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <ContentDownload placement="faq" />
  </main>
  <Footer t={t} lang="en" />
</Layout>

<script>
  const revealQuestion = () => {
    const target = document.getElementById(location.hash.slice(1));
    if (target instanceof HTMLDetailsElement) target.open = true;
  };
  document.querySelectorAll<HTMLAnchorElement>('a[href^="#question-"]').forEach((link) => link.addEventListener('click', () => {
    const target = document.getElementById(link.hash.slice(1));
    if (target instanceof HTMLDetailsElement) target.open = true;
  }));
  window.addEventListener('hashchange', revealQuestion);
  revealQuestion();
</script>

<style>
  @media (max-width: 768px) {
    .faq-page :global(section),
    .faq-page :global(div),
    .faq-page :global(p),
    .faq-page :global(h1),
    .faq-page :global(h2),
    .faq-page :global(h3) {
      word-break: normal;
      hyphens: none;
    }
  }
</style>
