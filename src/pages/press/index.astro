---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import { downloadLinks, siteUrl } from '../../data/appKnowledge';
import { translations } from '../../i18n/ui';

const t = translations.en;
const pressUrl = new URL('/press/', siteUrl).toString();
const media = [
  {
    number: '01',
    title: 'Observing forecast',
    description: 'Multi-model conditions, Moon context, and hourly planning.',
    src: '/press/stargazinghub-observing-forecast.webp',
    png: '/press/editorial/stargazinghub-observing-forecast.png',
    alt: 'Stargazing Hub observing forecast with stargazing index, Moon phase, and hourly conditions',
  },
  {
    number: '02',
    title: 'On-device recognition',
    description: 'A real wide-field night-sky photograph identified on the device.',
    src: '/press/stargazinghub-sky-recognition.webp',
    png: '/press/editorial/stargazinghub-sky-recognition.png',
    alt: 'Stargazing Hub recognition result with constellations over a real night-sky photograph',
  },
  {
    number: '03',
    title: 'Terrain-aware star chart',
    description: 'The identified sky continued in a chart with horizon and terrain context.',
    src: '/press/stargazinghub-star-chart.webp',
    png: '/press/editorial/stargazinghub-star-chart.png',
    alt: 'Stargazing Hub star chart showing a constellation above a realistic horizon',
  },
  {
    number: '04',
    title: 'Light-pollution planning',
    description: 'Location comparison using sky brightness and observing layers.',
    src: '/press/stargazinghub-light-pollution-map.webp',
    png: '/press/editorial/stargazinghub-light-pollution-map.png',
    alt: 'Stargazing Hub light-pollution map with observing overlays and timeline',
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Stargazing Hub App Store editorial brief',
  description:
    'Editorial brief for Stargazing Hub, including the August 2026 release focus, product workflow, downloadable assets, and review contact.',
  url: pressUrl,
  about: {
    '@type': 'SoftwareApplication',
    name: 'Stargazing Hub - Sky Live',
    operatingSystem: 'iOS, iPadOS',
    applicationCategory: 'EducationalApplication',
    installUrl: downloadLinks.appStore,
  },
};
---

<Layout
  title="Stargazing Hub | App Store Editorial Brief"
  description="The August 2026 editorial brief for Stargazing Hub: on-device sky-photo recognition, multi-model observing forecasts, a terrain-aware star chart, and planning maps."
  image="/press/stargazinghub-field-workflow-poster.jpg"
  lang="en"
  structuredData={structuredData}
>
  <main class="editorial-main">
    <section class="editorial-hero" aria-labelledby="editorial-title">
      <div class="editorial-shell">
        <header class="editorial-nav">
          <a href="/">
            <span aria-hidden="true">←</span>
            Stargazing Hub
          </a>
          <span>App Store editorial brief</span>
        </header>

        <div class="hero-grid">
          <div class="hero-copy">
            <p class="eyebrow">AUGUST 2026 / APP ENHANCEMENT</p>
            <h1 id="editorial-title">A photographed sky, understood offline.</h1>
            <p class="hero-lead">
              The August release connects on-device sky-photo recognition to the
              same field in Stargazing Hub’s multilingual star chart, with a
              workflow designed for review away from reception.
            </p>
            <div class="hero-actions">
              <a class="primary-action" href="#sequence">See the release sequence</a>
              <a class="text-action" href="mailto:axxu0607@gmail.com">
                Contact Aaron Hsu
                <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>

          <figure class="hero-media">
            <div class="media-datum">
              <span>02 / REVIEW</span>
              <span>Current iPhone interface</span>
            </div>
            <img
              src="/press/stargazinghub-sky-recognition.webp"
              alt="Stargazing Hub recognizing constellations in a real wide-field night-sky photograph"
              width="1080"
              height="1920"
            />
            <figcaption>
              A wide-field photograph remains on the device while the app identifies
              the captured sky.
            </figcaption>
          </figure>
        </div>

        <dl class="release-facts">
          <div>
            <dt>Release window</dt>
            <dd>August 18-28, 2026</dd>
          </div>
          <div>
            <dt>Platforms</dt>
            <dd>iPhone and iPad</dd>
          </div>
          <div>
            <dt>Review access</dt>
            <dd>TestFlight and promo code</dd>
          </div>
          <div>
            <dt>Editorial contact</dt>
            <dd><a href="mailto:axxu0607@gmail.com">Aaron Hsu</a></dd>
          </div>
        </dl>
      </div>
    </section>

    <section class="sequence-section" id="sequence" aria-labelledby="sequence-title">
      <div class="editorial-shell">
        <header class="section-heading">
          <p class="eyebrow">THE RELEASE IN THREE MOVES</p>
          <h2 id="sequence-title">The photograph becomes a place in the sky.</h2>
          <p>
            The editorial focus is continuity. A user can begin with the image they
            captured, understand it without relying on reception, and continue
            exploring the same field instead of starting over.
          </p>
        </header>

        <ol class="sequence-list">
          <li>
            <span>01</span>
            <div>
              <h3>Bring in a real photograph</h3>
              <p>
                Start with a wide-field night-sky image from an observing session,
                rather than a catalogue search.
              </p>
            </div>
          </li>
          <li>
            <span>02</span>
            <div>
              <h3>Identify it on-device</h3>
              <p>
                Review the captured field and constellation context without
                uploading the original photograph.
              </p>
            </div>
          </li>
          <li>
            <span>03</span>
            <div>
              <h3>Continue in the same sky</h3>
              <p>
                Open the recognized field in the multilingual star chart with
                horizon, terrain, and observing context.
              </p>
            </div>
          </li>
        </ol>

        <div class="sequence-media">
          <figure>
            <img
              src="/press/stargazinghub-sky-recognition.webp"
              alt="Recognized night-sky photograph in Stargazing Hub"
              width="1080"
              height="1920"
              loading="lazy"
            />
            <figcaption><span>02</span> Recognized photograph</figcaption>
          </figure>
          <figure>
            <img
              src="/press/stargazinghub-star-chart.webp"
              alt="The same sky explored in the Stargazing Hub star chart"
              width="1080"
              height="1920"
              loading="lazy"
            />
            <figcaption><span>03</span> Continued in the star chart</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="planning-section" aria-labelledby="planning-title">
      <div class="editorial-shell planning-grid">
        <header>
          <p class="eyebrow">BEFORE THE SHUTTER</p>
          <h2 id="planning-title">A night worth leaving home for.</h2>
          <p>
            The same app supports the decisions before the photograph. Users can
            compare hourly and 15-day observing conditions across multiple forecast
            models, then consider location, Moon, terrain, and light pollution.
          </p>
          <p class="boundary-note">
            Forecasts and maps are planning guidance, not visibility guarantees.
          </p>
        </header>
        <figure class="planning-media planning-media-large">
          <img
            src="/press/stargazinghub-observing-forecast.webp"
            alt="Stargazing Hub observing forecast"
            width="1080"
            height="1920"
            loading="lazy"
          />
          <figcaption><span>01</span> Multi-model observing context</figcaption>
        </figure>
        <figure class="planning-media">
          <img
            src="/press/stargazinghub-light-pollution-map.webp"
            alt="Stargazing Hub light-pollution planning map"
            width="1080"
            height="1920"
            loading="lazy"
          />
          <figcaption><span>04</span> Location and sky brightness</figcaption>
        </figure>
      </div>
    </section>

    <section class="demo-section" aria-labelledby="demo-title">
      <div class="editorial-shell demo-grid">
        <header>
          <p class="eyebrow">PRODUCT SEQUENCE</p>
          <h2 id="demo-title">Forty seconds, four field decisions.</h2>
          <p>
            A concise overview of the connected experience: location, conditions,
            on-device recognition, and the star chart.
          </p>
          <a href="/press/stargazinghub-field-workflow-2026.mp4" download>
            Download MP4
            <span aria-hidden="true">↓</span>
          </a>
        </header>
        <div class="video-frame">
          <video
            controls
            playsinline
            preload="metadata"
            poster="/press/stargazinghub-field-workflow-poster.jpg"
            aria-label="Stargazing Hub product sequence"
          >
            <source src="/press/stargazinghub-field-workflow-2026.mp4" type="video/mp4" />
            <a href="/press/stargazinghub-field-workflow-2026.mp4">Download the product video</a>
          </video>
          <div>
            <span>40 seconds</span>
            <span>1080p</span>
            <span>On-screen captions</span>
          </div>
        </div>
      </div>
    </section>

    <section class="story-section" aria-labelledby="story-title">
      <div class="editorial-shell story-grid">
        <div class="story-number">2018</div>
        <article>
          <p class="eyebrow">WHY IT EXISTS</p>
          <h2 id="story-title">Built after a forecast disappeared.</h2>
          <p class="story-lead">
            “I was planning a planetary-imaging session when 7Timer became
            unavailable. I wanted a tool my observing friends and I could still rely
            on in the field, so I began designing one.”
          </p>
          <p>
            Aaron Hsu is an amateur astronomer, product manager, and independent
            developer. Observing trips with friends continue to shape Stargazing Hub
            around practical decisions rather than a catalogue of isolated features.
          </p>
        </article>
        <aside>
          <h3>Editorial notes</h3>
          <ul>
            <li>Night-sky photographs can be recognized locally.</li>
            <li>The star chart is developed for multilingual field use.</li>
            <li>Alternate-language screenshots are available on request.</li>
            <li>TestFlight and promotional access are available to editors.</li>
          </ul>
        </aside>
      </div>
    </section>

    <section class="assets-section" aria-labelledby="assets-title">
      <div class="editorial-shell">
        <header class="assets-heading">
          <div>
            <p class="eyebrow">EDITORIAL ASSETS</p>
            <h2 id="assets-title">Four current product views.</h2>
          </div>
          <div>
            <a class="primary-action" href="/press/stargazinghub-press-kit-2026.zip" download>
              Download media kit
            </a>
            <p>PNG and WebP, captions and usage notes included.</p>
          </div>
        </header>

        <div class="asset-list">
          {media.map((item) => (
            <article>
              <a class="asset-image" href={item.png}>
                <img src={item.src} alt={item.alt} width="1080" height="1920" loading="lazy" />
              </a>
              <div class="asset-copy">
                <span>{item.number}</span>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
                <div>
                  <a href={item.png} download>PNG</a>
                  <a href={item.src} download>WebP</a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="contact-section" aria-labelledby="contact-title">
      <div class="editorial-shell contact-grid">
        <div>
          <p class="eyebrow">EDITORIAL CONTACT</p>
          <h2 id="contact-title">Review access and additional materials.</h2>
        </div>
        <address>
          <strong>Aaron Hsu</strong>
          <a href="mailto:axxu0607@gmail.com">axxu0607@gmail.com</a>
          <span>For editorial enquiries only</span>
        </address>
        <nav aria-label="Editorial links">
          <a href={downloadLinks.appStore}>
            View on the App Store
            <span aria-hidden="true">↗</span>
          </a>
          <a href="/features/sky-recognition/">
            Read the recognition guide
            <span aria-hidden="true">→</span>
          </a>
        </nav>
      </div>
    </section>
  </main>

  <Footer t={t} lang="en" />
</Layout>

<style>
  .editorial-main {
    position: relative;
    z-index: 1;
  }

  .editorial-shell {
    width: min(var(--shell), calc(100% - (var(--space-page) * 2)));
    margin: 0 auto;
  }

  .editorial-hero {
    padding: 28px 0 0;
  }

  .editorial-nav {
    min-height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--hairline);
  }

  .editorial-nav a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--mist);
    font-size: 13px;
    text-decoration: none;
  }

  .editorial-nav > span {
    color: var(--quiet);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 32px;
    padding: clamp(64px, 8vw, 112px) 0 0;
  }

  .hero-copy {
    grid-column: 1 / span 7;
    align-self: center;
    padding-bottom: 48px;
  }

  .eyebrow {
    margin-bottom: 22px;
    color: var(--brass);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 850px;
    margin: 0;
    font-size: clamp(4rem, 7vw, 7.7rem);
    line-height: 0.91;
    letter-spacing: -0.054em;
  }

  .hero-lead {
    max-width: 60ch;
    margin-top: 34px;
    color: var(--mist);
    font-size: clamp(1.05rem, 1.5vw, 1.25rem);
    line-height: 1.68;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 24px;
    margin-top: 36px;
  }

  .primary-action,
  .text-action {
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition:
      transform 160ms var(--ease-observatory),
      color 180ms var(--ease-observatory),
      background-color 180ms var(--ease-observatory);
  }

  .primary-action {
    padding: 0 19px;
    border-radius: var(--radius-sm);
    background: var(--brass);
    color: var(--canvas);
    font-size: 14px;
    font-weight: 600;
  }

  .text-action {
    gap: 22px;
    color: var(--mist);
    font-size: 13px;
  }

  .primary-action:active,
  .text-action:active {
    transform: scale(0.97);
  }

  .hero-media {
    grid-column: 9 / -1;
    margin: 0;
  }

  .media-datum {
    min-height: 42px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    border-bottom: 1px solid var(--hairline);
    color: var(--quiet);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .hero-media img {
    width: 100%;
    height: auto;
    outline: 1px solid oklch(0.93 0.012 86 / 0.12);
    outline-offset: -1px;
  }

  .hero-media figcaption {
    padding: 18px 0;
    border-bottom: 1px solid var(--hairline);
    color: var(--quiet);
    font-size: 12px;
    line-height: 1.55;
  }

  .release-facts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: clamp(52px, 7vw, 92px);
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }

  .release-facts > div {
    min-height: 106px;
    padding: 22px 20px;
  }

  .release-facts > div + div {
    border-left: 1px solid var(--hairline);
  }

  .release-facts dt {
    color: var(--quiet);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .release-facts dd {
    margin-top: 16px;
    color: var(--limestone);
    font-size: 14px;
  }

  .release-facts a {
    text-decoration: none;
  }

  .sequence-section,
  .planning-section,
  .demo-section,
  .story-section,
  .assets-section,
  .contact-section {
    padding: var(--section-space) 0;
    border-top: 1px solid var(--hairline);
  }

  .sequence-section {
    border-top: 0;
  }

  .section-heading {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 24px;
    align-items: end;
  }

  .section-heading .eyebrow {
    grid-column: 1 / span 3;
    align-self: start;
  }

  .section-heading h2 {
    grid-column: 4 / span 6;
    margin: 0;
    font-size: clamp(3rem, 5.7vw, 6rem);
    line-height: 0.95;
    letter-spacing: -0.046em;
  }

  .section-heading > p:last-child {
    grid-column: 10 / -1;
    color: var(--mist);
    font-size: 15px;
    line-height: 1.68;
  }

  .sequence-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: clamp(64px, 8vw, 104px) 0 0;
    padding: 0;
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
    list-style: none;
  }

  .sequence-list li {
    min-height: 242px;
    padding: 25px 24px 32px;
  }

  .sequence-list li + li {
    border-left: 1px solid var(--hairline);
  }

  .sequence-list li > span {
    color: var(--brass);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
  }

  .sequence-list li > div {
    margin-top: 62px;
  }

  .sequence-list h3 {
    margin: 0;
    font-size: clamp(1.35rem, 2vw, 1.8rem);
  }

  .sequence-list p {
    max-width: 34ch;
    margin-top: 14px;
    color: var(--mist);
    font-size: 14px;
    line-height: 1.65;
  }

  .sequence-media {
    display: grid;
    grid-template-columns: 1.18fr 0.82fr;
    gap: clamp(24px, 4vw, 58px);
    align-items: end;
    padding-top: clamp(72px, 10vw, 132px);
  }

  .sequence-media figure {
    margin: 0;
  }

  .sequence-media figure:first-child {
    max-width: 650px;
  }

  .sequence-media figure:last-child {
    max-width: 470px;
    justify-self: end;
  }

  .sequence-media img,
  .planning-media img {
    width: 100%;
    height: auto;
    outline: 1px solid oklch(0.93 0.012 86 / 0.12);
    outline-offset: -1px;
  }

  .sequence-media figcaption,
  .planning-media figcaption {
    display: flex;
    gap: 18px;
    padding: 16px 0;
    border-bottom: 1px solid var(--hairline);
    color: var(--mist);
    font-size: 12px;
  }

  .sequence-media figcaption span,
  .planning-media figcaption span {
    color: var(--brass);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.1em;
  }

  .planning-section {
    background: var(--canvas-raised);
  }

  .planning-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 30px;
    align-items: end;
  }

  .planning-grid > header {
    grid-column: 1 / span 5;
    align-self: start;
    padding-right: clamp(0px, 4vw, 54px);
  }

  .planning-grid h2,
  .demo-grid h2,
  .story-grid h2,
  .assets-heading h2,
  .contact-grid h2 {
    margin: 0;
    font-size: clamp(3rem, 5.2vw, 5.6rem);
    line-height: 0.96;
    letter-spacing: -0.045em;
  }

  .planning-grid header > p:not(.eyebrow, .boundary-note) {
    max-width: 48ch;
    margin-top: 28px;
    color: var(--mist);
    font-size: 16px;
    line-height: 1.72;
  }

  .boundary-note {
    max-width: 43ch;
    margin-top: 48px;
    padding-top: 18px;
    border-top: 1px solid var(--hairline);
    color: var(--quiet);
    font-size: 12px;
    line-height: 1.55;
  }

  .planning-media {
    grid-column: span 3;
    margin: 0;
  }

  .planning-media-large {
    grid-column: 6 / span 4;
  }

  .demo-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 30px;
    align-items: start;
  }

  .demo-grid > header {
    grid-column: 1 / span 4;
  }

  .demo-grid header > p:not(.eyebrow) {
    margin-top: 26px;
    color: var(--mist);
    font-size: 15px;
    line-height: 1.68;
  }

  .demo-grid header > a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: 28px;
    margin-top: 28px;
    color: var(--limestone);
    font-size: 13px;
    text-decoration: none;
  }

  .video-frame {
    grid-column: 6 / -1;
    padding: 12px;
    background: var(--canvas-raised);
    outline: 1px solid var(--hairline);
    outline-offset: -1px;
  }

  .video-frame video {
    width: 100%;
    aspect-ratio: 16 / 9;
    background: var(--canvas);
  }

  .video-frame > div {
    min-height: 42px;
    display: flex;
    align-items: center;
    gap: 18px;
    color: var(--quiet);
    font-size: 10px;
    letter-spacing: 0.06em;
  }

  .story-section {
    background: var(--limestone);
    color: var(--canvas);
  }

  .story-section .eyebrow {
    color: var(--brass-deep);
  }

  .story-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 28px;
  }

  .story-number {
    grid-column: 1 / span 3;
    color: oklch(0.13 0.018 258 / 0.22);
    font-size: clamp(4rem, 8vw, 8rem);
    font-weight: 600;
    letter-spacing: -0.06em;
    line-height: 0.8;
  }

  .story-grid article {
    grid-column: 4 / span 6;
  }

  .story-grid h2 {
    color: var(--canvas);
  }

  .story-lead {
    margin-top: 38px;
    color: var(--canvas);
    font-family: 'Iowan Old Style', 'Palatino Linotype', 'Book Antiqua', serif;
    font-size: clamp(1.45rem, 2.4vw, 2.15rem);
    line-height: 1.42;
  }

  .story-grid article > p:last-child {
    max-width: 57ch;
    margin-top: 28px;
    color: oklch(0.24 0.018 258);
    font-size: 15px;
    line-height: 1.7;
  }

  .story-grid aside {
    grid-column: 10 / -1;
    align-self: end;
    padding-top: 20px;
    border-top: 1px solid oklch(0.13 0.018 258 / 0.2);
  }

  .story-grid aside h3 {
    color: var(--canvas);
    font-size: 15px;
  }

  .story-grid ul {
    display: grid;
    gap: 10px;
    margin: 18px 0 0;
