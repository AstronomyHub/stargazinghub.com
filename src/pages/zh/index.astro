---
import Layout from '../../layouts/Layout.astro';
import HomeLanding from '../../components/home/HomeLanding.astro';
import { translations } from '../../i18n/ui';

const lang = 'zh';
const t = translations[lang];
---

<Layout title={t.meta?.title || '天文通：星图、光污染、极光预报与观星指数'} lang={lang} description={t.meta?.description}>
  <HomeLanding t={t} lang={lang} />
</Layout>
