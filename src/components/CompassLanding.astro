---
import ContentDownload from './ContentDownload.astro';
import StoreLinks from './home/StoreLinks.astro';
import { translations } from '../i18n/ui';
import { getCompass, compassLinks } from '../data/compassContent';

interface Props { lang: string }

const { lang } = Astro.props;
const source = getCompass(lang);
const c = source;
const t = { ...(translations[lang as keyof typeof translations] || translations.en), links: compassLinks };
const widgets = [...c.widgets].sort((a, b) => Number(b.img.includes('times')) - Number(a.img.includes('times')));
---

<main class="compass-page">

  <section class="hero" aria-labelledby="compass-title">
    <div class="shell hero-grid">
      <div class="hero-copy night-reveal">
        <p class="hero-kicker">{c.fromTeam}</p>
        <h1 id="compass-title" class="hero-title">{lang.startsWith('zh') ? c.title.split(/([·：:])/).map((part, index) => index % 2 === 0 ? <span class="compass-title-word">{part}</span> : part) : c.title}</h1>
        <p class="hero-summary">{c.subtitle}</p>
        <StoreLinks t={t} placement="compass-hero" />
        <p class="night-fine">{c.eyebrow}</p>
      </div>

      <figure class="hero-visual">
        <img
          src="/compass/app-altitude.webp"
          width="1200"
          height="2600"
          alt={c.features[0].title}
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </figure>
    </div>
  </section>

  <section class="fact-strip" aria-label={c.featuresTitle}>
    <div class="shell fact-grid">
      {c.badges.map((badge) => <p>{badge}</p>)}
    </div>
  </section>

  <section class="feature-section" aria-labelledby="feature-title">
    <div class="shell">
      <div class="section-heading">
        <h2 id="feature-title">{c.featuresTitle}</h2>
      </div>

      <div class="feature-layout">
        <figure class="field-photo">
          <img src="/compass/app-compass.webp" width="1200" height="2600" alt={c.features[1].title} loading="lazy" decoding="async" />
        </figure>

        <div class="feature-list">
          {c.features.map((feature) => (
            <article class="feature-item">
              <h3>{feature.title}</h3>
              <p>{feature.desc}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="widget-section" aria-labelledby="widget-title">
    <div class="shell">
      <div class="section-heading section-heading-narrow">
        <h2 id="widget-title">{c.widgetsTitle}</h2>
        <p>{c.widgetsSubtitle}</p>
      </div>

      <div class="widget-grid">
        {widgets.map((widget) => (
          <figure class:list={['widget-item', { 'widget-item-wide': widget.img.includes('times') }]}>
            <div class="widget-media">
              <img src={widget.img} alt={widget.title} loading="lazy" decoding="async" />
            </div>
            <figcaption>
              <h3>{widget.title}</h3>
              <p>{widget.desc}</p>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="golden-section" aria-labelledby="golden-title">
    <div class="shell golden-layout">
      <figure class="golden-photo" aria-hidden="true">
        <img src="/compass/sky-golden.jpg" width="1080" height="2400" alt="" loading="lazy" decoding="async" />
      </figure>
      <div class="golden-copy">
        <h2 id="golden-title">{c.goldenTitle}</h2>
        <p>{c.goldenDesc}</p>
        <a class="tool-link" href={compassLinks.goldenHour} target="_blank" rel="noopener noreferrer">
          {c.goldenCta}
        </a>
      </div>
    </div>
  </section>

  <section class="outdoor-section">
    <div class="shell outdoor-layout">
      <div class="use-cases">
        <h2>{c.useCasesTitle}</h2>
        <ul>
          {c.useCases.map((useCase) => <li>{useCase}</li>)}
        </ul>
      </div>
      <aside class="privacy-note" aria-labelledby="privacy-title">
        <h2 id="privacy-title">{c.privacyTitle}</h2>
        <p>{c.privacyDesc}</p>
      </aside>
    </div>
  </section>
  <ContentDownload lang={lang} product="compass" placement="compass-download" />
</main>

<style>
  .compass-page {
    --page: #071014;
    --surface: #0d171a;
    --surface-strong: #111d20;
    --line: rgba(223, 231, 225, 0.18);
    --line-strong: rgba(223, 231, 225, 0.32);
    --ink: #eef2ee;
    --ink-soft: #b8c2bc;
    --ink-muted: #87938d;
    --accent: #d9bd76;
    --accent-hover: #ead18f;
    --button-ink: #101714;
    --radius: 0.8rem;
    position: relative;
    z-index: 2;
    isolation: isolate;
    overflow: hidden;
    width: 100%;
    background: var(--page);
    color: var(--ink);
  }

  .shell {
    width: min(100% - 3rem, 78rem);
    margin-inline: auto;
  }

  .product-nav {
    border-bottom: 1px solid var(--line);
    background: var(--page);
  }

  .nav-inner {
    min-height: 4.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .product-home,
  .hub-link {
    color: var(--ink);
    text-decoration: none;
  }

  .product-home {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--sg-sans);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .product-home img {
    width: 2.5rem;
    height: 2.5rem;
    flex: 0 0 auto;
    border-radius: var(--radius);
  }

  .product-home span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .hub-link {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--ink-soft);
    font-size: 0.86rem;
    transition: color 160ms ease, transform 160ms ease;
  }

  .hub-link:hover {
    color: var(--ink);
    transform: translateX(-2px);
  }

  .hero {
    border-bottom: 1px solid var(--line);
  }

  .hero-grid {
    min-height: min(50rem, calc(100dvh - 4.25rem));
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: center;
    gap: clamp(2.5rem, 5vw, 5rem);
    padding-block: clamp(2.5rem, 7vh, 4.75rem);
  }

  .hero-copy {
    position: relative;
    z-index: 1;
  }

  .hero-kicker {
    margin: 0 0 1.25rem;
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .hero-title {
    max-width: 18ch;
    margin: 0;
    color: var(--ink);
    font-family: var(--sg-sans);
    font-size: clamp(3rem, 4.5vw, 4.2rem);
    font-weight: 650;
    letter-spacing: -0.055em;
    line-height: 0.98;
    text-wrap: balance;
  }

  .hero-summary {
    max-width: 38rem;
    margin: 1.6rem 0 0;
    color: var(--ink-soft);
    font-size: clamp(1rem, 1.6vw, 1.16rem);
    line-height: 1.65;
    text-wrap: pretty;
  }

  .store-actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    max-width: 32rem;
    margin-top: 2rem;
  }

  .store-button {
    min-height: 3.65rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--accent);
    border-radius: var(--radius);
    background: var(--accent);
    color: var(--button-ink);
    font-size: 0.86rem;
    font-weight: 700;
    line-height: 1.15;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 160ms ease, border-color 160ms ease, transform 160ms ease;
  }

  .store-button small {
    color: rgba(16, 23, 20, 0.65);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .store-button:hover {
    border-color: var(--accent-hover);
    background: var(--accent-hover);
    transform: translateY(-2px);
  }

  .store-button:active,
  .tool-link:active {
    transform: translateY(1px);
  }

  .hero-visual {
    position: relative;
    min-height: 0;
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--surface);
    aspect-ratio: 4 / 5;
  }

  .hero-visual::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 55%, rgba(7, 16, 20, 0.46));
    pointer-events: none;
  }

  .hero-visual img,
  .field-photo img,
  .golden-photo img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .hero-visual img {
    object-position: 50% 54%;
  }

  .fact-strip {
    border-bottom: 1px solid var(--line);
    background: #091215;
  }

  .fact-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .fact-grid p {
    min-height: 5.5rem;
    display: flex;
    align-items: center;
    margin: 0;
    padding: 1.25rem 1.5rem;
    border-left: 1px solid var(--line);
    color: var(--ink-soft);
    font-size: 0.84rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .fact-grid p:last-child {
    border-right: 1px solid var(--line);
  }

  .feature-section,
  .widget-section,
  .golden-section,
  .outdoor-section {
    padding-block: clamp(5rem, 10vw, 9rem);
  }

  .section-heading {
    max-width: 48rem;
    margin-bottom: clamp(2.5rem, 5vw, 4.5rem);
  }

  .section-heading h2,
  .golden-copy h2,
  .use-cases h2,
  .privacy-note h2 {
    margin: 0;
    color: var(--ink);
    font-family: var(--sg-sans);
    font-weight: 600;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .section-heading h2,
  .golden-copy h2 {
    font-size: clamp(2.35rem, 5vw, 4.35rem);
    line-height: 1;
  }

  .section-heading p,
  .golden-copy p,
  .privacy-note p {
    max-width: 60ch;
    margin: 1.1rem 0 0;
    color: var(--ink-soft);
    font-size: 1rem;
    line-height: 1.7;
    text-wrap: pretty;
  }

  .section-heading-narrow {
    max-width: 40rem;
  }

  .feature-layout {
    display: grid;
    grid-template-columns: minmax(17rem, 0.72fr) minmax(0, 1.28fr);
    align-items: start;
    gap: clamp(2.5rem, 7vw, 7rem);
  }

  .field-photo {
    position: sticky;
    top: 2rem;
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius);
    aspect-ratio: 3 / 4;
    background: var(--surface);
  }

  .field-photo img {
    object-position: 50% 49%;
  }

  .feature-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 2rem;
  }

  .feature-item {
    padding-block: 1.55rem 1.8rem;
    border-top: 1px solid var(--line);
  }

  .feature-item:nth-child(-n + 2) {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(9rem, 0.62fr) minmax(0, 1.38fr);
    gap: 2rem;
  }

  .feature-item h3,
  .widget-item h3 {
    margin: 0;
    color: var(--ink);
    font-family: var(--sg-sans);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .feature-item h3 {
    font-size: 1.15rem;
    line-height: 1.25;
  }

  .feature-item p,
  .widget-item p {
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.91rem;
    line-height: 1.65;
    text-wrap: pretty;
  }

  .feature-item:not(:nth-child(-n + 2)) h3 {
    margin-bottom: 0.65rem;
  }

  .widget-section {
    border-block: 1px solid var(--line);
    background: var(--surface);
  }

  .widget-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) repeat(2, minmax(12rem, 0.7fr));
    gap: 1rem;
    align-items: stretch;
  }

  .widget-item {
    min-width: 0;
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: clamp(1.2rem, 3vw, 2rem);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: #0a1119;
  }

  .widget-media {
    min-height: 17rem;
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: center;
  }

  .widget-item img {
    display: block;
    width: min(100%, 15rem);
    height: auto;
  }

  .widget-item-wide img {
    width: min(100%, 38rem);
  }

  .widget-item figcaption {
    margin-top: 1.35rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
  }

  .widget-item h3 {
    margin-bottom: 0.35rem;
    font-size: 1rem;
  }

  .golden-layout {
    display: grid;
    grid-template-columns: minmax(17rem, 0.82fr) minmax(0, 1.18fr);
    align-items: center;
    gap: clamp(2.5rem, 8vw, 8rem);
  }

  .golden-photo {
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius);
    aspect-ratio: 4 / 5;
    background: var(--surface);
  }

  .golden-photo img {
    object-position: 50% 50%;
  }

  .tool-link {
    min-height: 3.25rem;
    width: fit-content;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 1.9rem;
    padding: 0.8rem 1.1rem;
    border: 1px solid var(--accent);
    border-radius: var(--radius);
    background: transparent;
    color: var(--accent);
    font-size: 0.9rem;
    font-weight: 700;
    line-height: 1.2;
    text-decoration: none;
    transition: background-color 160ms ease, color 160ms ease, transform 160ms ease;
  }

  .tool-link:hover {
    background: var(--accent);
    color: var(--button-ink);
    transform: translateY(-2px);
  }

  .outdoor-section {
    border-top: 1px solid var(--line);
    background: #091215;
  }

  .outdoor-layout {
    display: grid;
    grid-template-columns: minmax(15rem, 0.72fr) minmax(0, 1.28fr);
    gap: clamp(2.5rem, 8vw, 8rem);
    align-items: start;
  }

  .use-cases h2,
  .privacy-note h2 {
    font-size: clamp(1.75rem, 3.2vw, 2.7rem);
    line-height: 1.08;
  }

  .use-cases ul {
    display: grid;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .use-cases li {
    padding-block: 1rem;
    border-top: 1px solid var(--line);
    color: var(--ink-soft);
    font-size: 0.94rem;
    line-height: 1.45;
  }

  .privacy-note {
    padding: clamp(1.75rem, 4vw, 3.5rem);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--surface-strong);
  }

  @media (max-width: 64rem) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.82fr);
      gap: 2.5rem;
    }

    .store-actions {
      grid-template-columns: 1fr;
      max-width: 24rem;
    }

    .widget-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .widget-item-wide {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 47.99rem) {
    .shell {
      width: min(100% - 2rem, 42rem);
    }

    .nav-inner {
      min-height: 3.75rem;
      gap: 1rem;
    }

    .product-home {
      max-width: 54%;
    }

    .product-home img {
      width: 2.2rem;
      height: 2.2rem;
    }

    .product-home span {
      font-size: 0.8rem;
    }

    .hub-link {
      font-size: 0.8rem;
    }

    .hero-grid {
      min-height: auto;
      grid-template-columns: 1fr;
      gap: 2.5rem;
      padding-block: 3.25rem 2rem;
    }

    .hero-kicker {
      margin-bottom: 1rem;
    }

    .hero-title {
      max-width: none;
      font-size: clamp(2.55rem, 12.5vw, 3.8rem);
      letter-spacing: -0.045em;
      line-height: 1;
    }

    .hero-summary {
      margin-top: 1.25rem;
      font-size: 1rem;
    }

    .store-actions {
      max-width: none;
      margin-top: 1.6rem;
    }

    .hero-visual {
      max-height: 29rem;
      aspect-ratio: 4 / 5;
    }

    .fact-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .fact-grid p {
      min-height: 4.8rem;
      padding: 1rem;
      border-bottom: 1px solid var(--line);
      font-size: 0.78rem;
    }

    .fact-grid p:nth-child(odd) {
      border-left: 1px solid var(--line);
    }

    .fact-grid p:nth-child(even) {
      border-right: 1px solid var(--line);
    }

    .fact-grid p:nth-last-child(-n + 2) {
      border-bottom: 0;
    }

    .feature-section,
    .widget-section,
    .golden-section,
    .outdoor-section {
      padding-block: 5rem;
    }

    .section-heading {
      margin-bottom: 2.5rem;
    }

    .section-heading h2,
    .golden-copy h2 {
      font-size: clamp(2.25rem, 11vw, 3.25rem);
    }

    .feature-layout,
    .golden-layout,
    .outdoor-layout {
      grid-template-columns: 1fr;
      gap: 2.75rem;
    }

    .field-photo {
      position: relative;
      top: auto;
      aspect-ratio: 16 / 11;
    }

    .feature-list,
    .feature-item:nth-child(-n + 2) {
      grid-template-columns: 1fr;
    }

    .feature-item,
    .feature-item:nth-child(-n + 2) {
      grid-column: auto;
      display: block;
    }

    .feature-item h3 {
      margin-bottom: 0.65rem;
    }

    .widget-grid {
      grid-template-columns: 1fr;
    }

    .widget-item-wide {
      grid-column: auto;
    }

    .widget-media {
      min-height: 13rem;
    }

    .golden-photo {
      max-height: 33rem;
      aspect-ratio: 4 / 5;
    }

    .privacy-note {
      padding: 1.5rem;
    }
  }

  @media (max-width: 23.5rem) {
    .shell {
      width: calc(100% - 2rem);
    }

    .product-home span {
      display: none;
    }

    .product-home {
      max-width: none;
    }

    .store-button {
      width: 100%;
      font-size: 0.82rem;
    }

    .fact-grid {
      grid-template-columns: 1fr;
    }

    .fact-grid p,
    .fact-grid p:nth-child(n) {
      min-height: auto;
      border-right: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
    }

    .fact-grid p:last-child {
      border-bottom: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hub-link,
    .store-button,
    .tool-link {
      transition: none;
    }

    .hub-link:hover,
    .store-button:hover,
    .store-button:active,
    .tool-link:hover,
    .tool-link:active {
      transform: none;
    }
  }
</style>
