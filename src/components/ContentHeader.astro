---
import { Image } from 'astro:assets';
import icon from '../assets/icon.webp';
import { translations } from '../i18n/ui';
import { getAccessibilityUi, getMarketingUi } from '../i18n/marketing';
import { websiteLocales } from '../data/appKnowledge';
import { getCompass, compassPath } from '../data/compassContent';
interface Props { lang: string; }
const { lang } = Astro.props;
const t = translations[lang as keyof typeof translations] || translations.en;
const a11y = getAccessibilityUi(lang);
const ui = getMarketingUi(lang);
const locale = websiteLocales.find((item) => item.code === lang) || websiteLocales[0];
const path = Astro.url.pathname;
const isCompass = path.includes('/compass-altimeter');
const isMarketing = isCompass || path.includes('/features') || path.includes('/faq');
const compass = getCompass(lang);
---
<header class="content-header">
  <div class="night-container night-nav">
    <a class="night-brand" href={isCompass ? compassPath(lang) : locale.path}>
      {isCompass ? <img src="/compass/icon.png" alt="" width="34" height="34" /> : <Image src={icon} alt="" width={34} height={34} />}
      <span>{isCompass ? compass.title.split(/[:：·]/)[0].trim() : t.brand.name}</span>
    </a>
    <nav aria-label={a11y.primaryNavigation}>
      {isCompass ? <a class="content-nav-link" href={locale.path}>{compass.backToHub}</a> : <>
        <a class="content-nav-link" href="/features/" aria-current={path.includes('/features') ? 'page' : undefined}>{t.navbar.features}</a>
        <a class="content-nav-link" href="/faq/" aria-current={path.includes('/faq') ? 'page' : undefined}>FAQ</a>
      </>}
      <button class="night-language-trigger" type="button" data-language-open aria-label={`${ui.languages} · ${locale.name}`} aria-haspopup="dialog" aria-controls="language-picker">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="9"/><ellipse cx="12" cy="12" rx="4" ry="9"/><path d="M3 12h18"/></svg><span>{locale.name}</span>
      </button>
      <a class="night-button" href={isMarketing ? '#download' : `${locale.path}#download`}>{t.navbar.download}<span aria-hidden="true">↓</span></a>
    </nav>
  </div>
</header>
