---
import { getLocalizedReviews, getReviewPageCopy } from '../i18n/reviews';

interface Props {
  t: any;
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const copy = getReviewPageCopy(lang);
const reviews = getLocalizedReviews(lang);
const orderedReviews = lang === 'zh' || lang === 'zh-tw'
  ? reviews
  : [reviews[1]!, reviews[2]!, reviews[0]!];

const formatDate = (date: string) => {
  const formatted = new Intl.DateTimeFormat(copy.localeTag, {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC',
  }).format(new Date(`${date}T00:00:00Z`));

  return lang === 'zh' || lang === 'zh-tw'
    ? formatted.replace(/(\d)(?=[年月日])/g, '$1 ').replace(/([年月])(?=\d)/g, '$1 ')
    : formatted;
};

const storeName = (store: string) => store === 'app-store' ? 'App Store' : 'Google Play';
---

<section class="home-reviews home-section relative isolate overflow-hidden px-6" id="reviews" aria-labelledby="store-reviews-title" data-motion-section>
  <div class="relative z-10 mx-auto max-w-7xl">
    <header class="home-section-header" data-motion-header>
      <h2 id="store-reviews-title">{copy.title}</h2>
    </header>

    <div class="home-review-grid">
      {orderedReviews.map((review) => (
        <article
          class="store-review-card glass-card relative overflow-hidden"
          data-review-id={review.reviewId}
          data-store={review.store}
          data-verified-at={review.verifiedAt}
          data-motion-item
        >
          <div class="store-review-stars" role="img" aria-label={copy.ratingLabel}>
            <span aria-hidden="true">★★★★★</span>
            <strong>5/5</strong>
          </div>
          <blockquote cite={review.sourceUrl}>
            <p>“{review.localizedQuote}”</p>
          </blockquote>
          {review.translationNote && <p class="store-review-translation">{review.translationNote}</p>}
          <footer>
            <strong>{review.author}</strong>
            <span>{storeName(review.store)} {review.storefront}</span>
            <time datetime={review.date}>{formatDate(review.date)}</time>
            <a href={review.sourceUrl} target="_blank" rel="noopener noreferrer">{copy.source}</a>
          </footer>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .home-reviews {
    padding-block: clamp(5.75rem, 8.5vw, 8.5rem);
  }

  .home-reviews::before {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, transparent, rgb(255 255 255 / 0.045), transparent) top / 100% 1px no-repeat;
    content: '';
  }

  .home-review-grid {
    display: grid;
    grid-template-columns: 0.92fr 1.12fr 0.96fr;
    gap: 1rem;
    align-items: start;
  }

  .store-review-card {
    min-width: 0;
    min-height: 22rem;
    display: flex;
    flex-direction: column;
    padding: 2rem;
    border-color: rgb(255 255 255 / 0.11);
    border-radius: 1.5rem;
    background: linear-gradient(150deg, rgb(255 255 255 / 0.05), rgb(255 255 255 / 0.014)), rgb(5 5 24 / 0.66);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.065),
      0 22px 64px rgb(0 0 20 / 0.18);
  }

  .store-review-card:nth-child(2) {
    min-height: 23.5rem;
    margin-top: 1.5rem;
    background: linear-gradient(150deg, rgb(255 255 255 / 0.062), rgb(255 255 255 / 0.018)), rgb(5 5 24 / 0.7);
  }

  .store-review-card:nth-child(3) {
    margin-top: 0.6rem;
  }

  .store-review-card:hover {
    border-color: rgb(255 255 255 / 0.2);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.12),
      0 26px 72px rgb(14 20 48 / 0.24);
    transform: translateY(-3px);
  }

  .store-review-card::before {
    position: absolute;
    right: 1.5rem;
    bottom: -1rem;
    color: rgb(255 255 255 / 0.045);
    content: '“';
    font-family: Georgia, serif;
    font-size: 7rem;
    line-height: 1;
    pointer-events: none;
  }

  .store-review-stars {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 1.6rem;
    color: #f5bf4f;
    font-size: 0.9rem;
    letter-spacing: 0.06em;
  }

  .store-review-stars strong {
    color: var(--text-secondary);
    font-size: 0.74rem;
    letter-spacing: 0;
  }

  .store-review-card blockquote {
    margin: 0;
  }

  .store-review-card blockquote p {
    display: -webkit-box;
    min-height: 6.2em;
    margin: 0;
    overflow: hidden;
    color: var(--text-primary);
    font-size: 1.08rem;
    line-height: 1.6;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .store-review-translation {
    margin: 0.75rem 0 0;
    color: var(--text-muted);
    font-size: 0.7rem;
  }

  .store-review-card footer {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.35rem 0.75rem;
    align-items: baseline;
    margin-top: auto;
    padding-top: 1.1rem;
    border-top: 1px solid rgb(255 255 255 / 0.1);
    color: var(--text-muted);
    font-size: 0.72rem;
  }

  .store-review-card footer strong {
    min-width: 0;
    overflow: hidden;
    color: var(--text-primary);
    font-size: 0.84rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .store-review-card footer time {
    justify-self: end;
  }

  .store-review-card footer a {
    justify-self: end;
    color: var(--nitrogen-cyan);
    text-decoration: none;
  }

  .store-review-card footer a:hover {
    color: var(--text-primary);
  }

  @media (max-width: 1023px) {
    .home-review-grid {
      grid-template-columns: 1fr;
    }

    .store-review-card,
    .store-review-card:nth-child(2),
    .store-review-card:nth-child(3) {
      min-height: 0;
      margin-top: 0;
    }
  }

  @media (max-width: 640px) {
    .home-reviews {
      padding-block: 4.75rem;
    }

    .store-review-card {
      padding: 1.5rem;
    }

    .store-review-card blockquote p {
      display: block;
      min-height: auto;
      overflow: visible;
      -webkit-line-clamp: unset;
    }
  }

  @media (max-width: 360px) {
    .store-review-card {
      padding: 1.2rem;
    }

    .store-review-card blockquote p {
      font-size: 0.94rem;
    }
  }
</style>
