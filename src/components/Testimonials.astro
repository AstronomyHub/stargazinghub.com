---
import { getLocalizedReviews, getReviewPageCopy } from '../i18n/reviews';

interface Props {
  t: any;
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const copy = getReviewPageCopy(lang);
const reviews = getLocalizedReviews(lang);
const orderedReviews = lang === 'zh' || lang === 'zh-tw'
  ? reviews
  : [reviews[1]!, reviews[2]!, reviews[0]!];

const formatDate = (date: string) => {
  const formatted = new Intl.DateTimeFormat(copy.localeTag, {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC',
  }).format(new Date(`${date}T00:00:00Z`));

  return lang === 'zh' || lang === 'zh-tw'
    ? formatted.replace(/(\d)(?=[年月日])/g, '$1 ').replace(/([年月])(?=\d)/g, '$1 ')
    : formatted;
};

const storeName = (store: string) => store === 'app-store' ? 'App Store' : 'Google Play';
---

<section class="relative isolate overflow-hidden px-6 py-20" id="reviews" aria-labelledby="store-reviews-title">
  <div class="cosmic-nebula nebula-1" style="top:5%;left:-12%"></div>
  <div class="cosmic-nebula nebula-2" style="right:-12%;bottom:0"></div>

  <div class="relative z-10 mx-auto max-w-7xl">
    <header class="mb-10 text-center">
      <h2 id="store-reviews-title" class="mb-4">
        <span class="gradient-text">{copy.title}</span>
      </h2>
      <p class="mx-auto max-w-2xl text-base leading-relaxed text-[var(--text-secondary)]">{copy.subtitle}</p>
    </header>

    <div class="grid gap-5 lg:grid-cols-3">
      {orderedReviews.map((review) => (
        <article
          class="store-review-card glass-card relative overflow-hidden p-6"
          data-review-id={review.reviewId}
          data-store={review.store}
          data-verified-at={review.verifiedAt}
        >
          <div class="store-review-stars" role="img" aria-label={copy.ratingLabel}>
            <span aria-hidden="true">★★★★★</span>
            <strong>5/5</strong>
          </div>
          <blockquote cite={review.sourceUrl}>
            <p>“{review.localizedQuote}”</p>
          </blockquote>
          {review.translationNote && <p class="store-review-translation">{review.translationNote}</p>}
          <footer>
            <strong>{review.author}</strong>
            <span>{storeName(review.store)} {review.storefront}</span>
            <time datetime={review.date}>{formatDate(review.date)}</time>
            <a href={review.sourceUrl} target="_blank" rel="noopener noreferrer">{copy.source}</a>
          </footer>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .store-review-card {
    min-width: 0;
    display: flex;
    flex-direction: column;
    border-color: rgb(255 255 255 / 0.12);
  }

  .store-review-stars {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 1.15rem;
    color: #f5bf4f;
    font-size: 0.9rem;
    letter-spacing: 0.06em;
  }

  .store-review-stars strong {
    color: var(--text-secondary);
    font-size: 0.74rem;
    letter-spacing: 0;
  }

  .store-review-card blockquote {
    margin: 0;
  }

  .store-review-card blockquote p {
    display: -webkit-box;
    min-height: 4.65em;
    margin: 0;
    overflow: hidden;
    color: var(--text-primary);
    font-size: 1rem;
    line-height: 1.55;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .store-review-translation {
    margin: 0.75rem 0 0;
    color: var(--text-muted);
    font-size: 0.7rem;
  }

  .store-review-card footer {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.35rem 0.75rem;
    align-items: baseline;
    margin-top: 1.4rem;
    padding-top: 1.1rem;
    border-top: 1px solid rgb(255 255 255 / 0.1);
    color: var(--text-muted);
    font-size: 0.72rem;
  }

  .store-review-card footer strong {
    min-width: 0;
    overflow: hidden;
    color: var(--text-primary);
    font-size: 0.84rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .store-review-card footer time {
    justify-self: end;
  }

  .store-review-card footer a {
    justify-self: end;
    color: var(--nitrogen-cyan);
    text-decoration: none;
  }

  .store-review-card footer a:hover {
    color: var(--text-primary);
  }

  @media (max-width: 360px) {
    .store-review-card {
      padding: 1.2rem;
    }

    .store-review-card blockquote p {
      font-size: 0.94rem;
    }
  }
</style>
