---
import { Image } from 'astro:assets';
import googleplayScreenshotsConfig from '../googleplay-screenshots.config.json';
import { getAppStoreRating } from '../lib/appStoreRating';
import iconImage from '../assets/icon.webp';

const allScreenshots = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/screenshots/**/*.{webp,png,jpg}',
  { eager: true },
);

interface Props {
  t: any;
  lang?: string;
}

interface HeroProofCopy {
  installs: string;
  checked: string;
  appLanguages: string;
  ratings: string;
  usAppStore: string;
  carousel: string;
  previous: string;
  next: string;
  pause: string;
  play: string;
}

const defaultProofCopy: HeroProofCopy = {
  installs: 'All-platform installs',
  checked: 'Aug 2026',
  appLanguages: 'App languages',
  ratings: 'ratings',
  usAppStore: 'US App Store',
  carousel: 'Stargazing Hub feature screenshots',
  previous: 'Previous screenshot',
  next: 'Next screenshot',
  pause: 'Pause carousel',
  play: 'Play carousel',
};

const proofCopyByLanguage: Record<string, HeroProofCopy> = {
  en: defaultProofCopy,
  zh: {
    installs: '全平台累计安装',
    checked: '2026 年 8 月',
    appLanguages: 'App 支持语言',
    ratings: '个评分',
    usAppStore: '美国区 App Store',
    carousel: '天文通功能截图',
    previous: '上一张截图',
    next: '下一张截图',
    pause: '暂停轮播',
    play: '继续轮播',
  },
  'zh-tw': {
    installs: '全平台累計安裝',
    checked: '2026 年 8 月',
    appLanguages: 'App 支援語言',
    ratings: '個評分',
    usAppStore: '美國區 App Store',
    carousel: '天文通功能截圖',
    previous: '上一張截圖',
    next: '下一張截圖',
    pause: '暫停輪播',
    play: '繼續輪播',
  },
  ja: {
    installs: '全プラットフォーム累計',
    checked: '2026年8月',
    appLanguages: 'App 対応言語',
    ratings: '件の評価',
    usAppStore: '米国 App Store',
    carousel: 'Stargazing Hub の機能画面',
    previous: '前の画面',
    next: '次の画面',
    pause: '自動再生を一時停止',
    play: '自動再生を再開',
  },
  ko: {
    installs: '전체 플랫폼 누적 설치',
    checked: '2026년 8월',
    appLanguages: 'App 지원 언어',
    ratings: '개 평점',
    usAppStore: '미국 App Store',
    carousel: 'Stargazing Hub 기능 화면',
    previous: '이전 화면',
    next: '다음 화면',
    pause: '자동 재생 일시 정지',
    play: '자동 재생 시작',
  },
  de: {
    installs: 'Installationen gesamt',
    checked: 'August 2026',
    appLanguages: 'App-Sprachen',
    ratings: 'Bewertungen',
    usAppStore: 'App Store USA',
    carousel: 'Funktionsbilder von Stargazing Hub',
    previous: 'Vorheriges Bild',
    next: 'Nächstes Bild',
    pause: 'Karussell anhalten',
    play: 'Karussell starten',
  },
  fr: {
    installs: 'Installations cumulées',
    checked: 'Août 2026',
    appLanguages: 'Langues de l’app',
    ratings: 'notes',
    usAppStore: 'App Store États-Unis',
    carousel: 'Captures des fonctions de Stargazing Hub',
    previous: 'Capture précédente',
    next: 'Capture suivante',
    pause: 'Mettre le carrousel en pause',
    play: 'Relancer le carrousel',
  },
  es: {
    installs: 'Instalaciones acumuladas',
    checked: 'Agosto de 2026',
    appLanguages: 'Idiomas de la app',
    ratings: 'valoraciones',
    usAppStore: 'App Store de EE. UU.',
    carousel: 'Capturas de las funciones de Stargazing Hub',
    previous: 'Captura anterior',
    next: 'Captura siguiente',
    pause: 'Pausar carrusel',
    play: 'Reanudar carrusel',
  },
  it: {
    installs: 'Installazioni totali',
    checked: 'Agosto 2026',
    appLanguages: 'Lingue dell’app',
    ratings: 'valutazioni',
    usAppStore: 'App Store USA',
    carousel: 'Schermate delle funzioni di Stargazing Hub',
    previous: 'Schermata precedente',
    next: 'Schermata successiva',
    pause: 'Metti in pausa',
    play: 'Riprendi il carosello',
  },
  ru: {
    installs: 'Всего установок',
    checked: 'Август 2026',
    appLanguages: 'Языки приложения',
    ratings: 'оценок',
    usAppStore: 'App Store в США',
    carousel: 'Экраны функций Stargazing Hub',
    previous: 'Предыдущий экран',
    next: 'Следующий экран',
    pause: 'Остановить карусель',
    play: 'Запустить карусель',
  },
  nl: {
    installs: 'Totaal aantal installaties',
    checked: 'Augustus 2026',
    appLanguages: 'App-talen',
    ratings: 'beoordelingen',
    usAppStore: 'App Store VS',
    carousel: 'Functieschermen van Stargazing Hub',
    previous: 'Vorige afbeelding',
    next: 'Volgende afbeelding',
    pause: 'Carrousel pauzeren',
    play: 'Carrousel hervatten',
  },
  pl: {
    installs: 'Łączna liczba instalacji',
    checked: 'Sierpień 2026',
    appLanguages: 'Języki aplikacji',
    ratings: 'ocen',
    usAppStore: 'App Store w USA',
    carousel: 'Ekrany funkcji Stargazing Hub',
    previous: 'Poprzedni ekran',
    next: 'Następny ekran',
    pause: 'Wstrzymaj karuzelę',
    play: 'Wznów karuzelę',
  },
};

const { t, lang = 'en' } = Astro.props;
const proofCopy = proofCopyByLanguage[lang] ?? defaultProofCopy;
const appStoreRating = await getAppStoreRating(lang);
const appStoreRatingValue = typeof appStoreRating.ratingValue === 'number'
  ? appStoreRating.ratingValue
  : null;
const appStoreRatingCount = typeof appStoreRating.ratingCount === 'number'
  ? appStoreRating.ratingCount
  : null;
const verifiedAppStoreRating = appStoreRating.source === 'app-store'
  && appStoreRatingValue !== null
  && appStoreRatingCount !== null
  ? {
      ...appStoreRating,
      ratingValue: appStoreRatingValue,
      ratingCount: appStoreRatingCount,
    }
  : null;

const appStoreName = proofCopy.usAppStore;
const appStoreAria = verifiedAppStoreRating
  ? `${verifiedAppStoreRating.displayValue} / 5, ${verifiedAppStoreRating.displayCount} ${proofCopy.ratings}, ${appStoreName}`
  : '';

const gpConfig = googleplayScreenshotsConfig[lang as keyof typeof googleplayScreenshotsConfig]
  ?? googleplayScreenshotsConfig.en;
const screenshotPaths = gpConfig?.files ?? [];
const screenshotFeatureKeys = ['weather', 'free', 'starMap', 'satellite', 'aurora', 'solar', 'tools'] as const;
const screenshotAlt = (index: number) => {
  const featureKey = screenshotFeatureKeys[index];
  const featureTitle = featureKey ? t.features?.[featureKey]?.title : undefined;
  return `${t.brand?.name}: ${featureTitle ?? `feature ${index + 1}`}`;
};
const screenshots = screenshotPaths.flatMap((path: string) => {
  const screenshot = allScreenshots[path]?.default;
  return screenshot ? [{ src: screenshot, path }] : [];
});

const fanPositions = [
  { x: 0, scale: 1, opacity: 1, z: 100 },
  { x: 65, scale: 0.96, opacity: 0.93, z: 99 },
  { x: 105, scale: 0.90, opacity: 0.81, z: 98 },
  { x: 145, scale: 0.84, opacity: 0.69, z: 97 },
  { x: 185, scale: 0.78, opacity: 0.57, z: 96 },
  { x: 225, scale: 0.72, opacity: 0.45, z: 95 },
  { x: 265, scale: 0.66, opacity: 0.33, z: 94 },
];
---

<section class="relative flex min-h-[100dvh] items-center overflow-hidden px-6 py-8 sm:py-12 md:py-16">
  <div class="cosmic-nebula nebula-1"></div>
  <div class="cosmic-nebula nebula-2"></div>
  <div class="cosmic-nebula nebula-3"></div>

  <div class="relative z-10 mx-auto w-full max-w-7xl">
    <div class="flex flex-col items-center gap-8 lg:flex-row lg:gap-16">
      <div class="flex-1 text-left lg:pr-8">
        <div class="mb-6 flex items-center gap-4" data-hero-reveal>
          <div class="relative group">
            <div class="absolute -inset-2 rounded-2xl bg-gradient-to-r from-[var(--hydrogen-pink)] via-[var(--carbon-purple)] to-[var(--nitrogen-cyan)] opacity-60 blur-lg transition-opacity duration-500 group-hover:opacity-80"></div>
            <div class="glass-strong relative overflow-hidden rounded-xl">
              <Image src={iconImage} alt="" class="h-12 w-12" width={48} height={48} />
            </div>
          </div>
          <div class="flex flex-col">
            <span class="text-2xl font-bold tracking-tight">{t.brand?.name}</span>
            <span class="mt-1 text-[11px] tracking-wide text-[var(--text-muted)]">{t.hero.platformLabel}</span>
          </div>
        </div>

        <h1 class="mb-4 break-normal hyphens-none text-4xl font-bold leading-[1.05] md:text-5xl lg:text-[3rem]" data-hero-reveal>
          <span class="gradient-text">{t.hero.title}</span>
        </h1>
        <p class="mb-4 max-w-lg break-normal hyphens-none text-xl text-[var(--text-secondary)] md:text-2xl" data-hero-reveal>
          {t.hero.subtitle}
        </p>
        <div class="mb-6 flex flex-col gap-3 sm:flex-row" data-hero-reveal>
          <a
            href={t.links?.appStore}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary group flex items-center gap-4 px-9 py-4 text-lg"
            data-store="app-store"
            data-placement="hero"
          >
            <svg class="h-9 w-9" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z" />
            </svg>
            <span class="text-left">
              <small class="block text-xs opacity-80">{t.download.appStore}</small>
              <strong class="block">App Store</strong>
            </span>
          </a>
          <a
            href={t.links?.googlePlay}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary group flex items-center gap-4 px-9 py-4 text-lg"
            style="--gradient-nebula:linear-gradient(135deg,#247b75 0%,#087b91 52%,#7654d9 100%)"
            data-store="google-play"
            data-placement="hero"
          >
            <svg class="h-9 w-9" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M3 20.5v-17c0-.59.34-1.11.84-1.35L13.69 12l-9.85 9.85A1.5 1.5 0 0 1 3 20.5m13.81-5.38L6.05 21.34l8.49-8.49 2.27 2.27m3.35-4.31c.34.27.59.69.59 1.19s-.22.9-.57 1.18l-2.29 1.32-2.5-2.5 2.5-2.5 2.27 1.31M6.05 2.66l10.76 6.22-2.27 2.27-8.49-8.49Z" />
            </svg>
            <span class="text-left">
              <small class="block text-xs opacity-80">{t.download.googlePlay}</small>
              <strong class="block">Google Play</strong>
            </span>
          </a>
        </div>

        <div class="hero-proof-grid glass" data-hero-reveal>
          <div class="hero-proof-card">
            <strong class="gradient-text-warm">3M+</strong>
            <span>{proofCopy.installs}<small>{proofCopy.checked}</small></span>
          </div>
          {verifiedAppStoreRating && (
            <div class="hero-proof-card">
              <div class="hero-rating-value">
                <span
                  class="rating-stars"
                  style={`--rating-fill:${verifiedAppStoreRating.ratingValue / 5 * 100}%`}
                  role="img"
                  aria-label={appStoreAria}
                >
                  <span class="rating-stars-base" aria-hidden="true">★★★★★</span>
                  <span class="rating-stars-fill" aria-hidden="true">★★★★★</span>
                </span>
                <strong class="gradient-text-cool">{verifiedAppStoreRating.displayValue}</strong>
              </div>
              <span>{appStoreName}<small>{verifiedAppStoreRating.displayCount} {proofCopy.ratings}</small></span>
            </div>
          )}
          <div class="hero-proof-card">
            <strong class="gradient-text">14</strong>
            <span>{proofCopy.appLanguages}</span>
          </div>
        </div>
      </div>

      <div
        id="hero-carousel"
        class="hero-carousel flex w-full flex-1 items-center justify-center lg:justify-end"
        role="region"
        aria-label={proofCopy.carousel}
        data-pause-label={proofCopy.pause}
        data-play-label={proofCopy.play}
      >
        <div class="w-full lg:hidden">
          <div id="hero-mobile-gallery" class="no-scrollbar flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-smooth px-4 pb-5">
            {screenshots.map((item, index) => (
              <figure class="hero-mobile-card relative aspect-[9/16] w-[70vw] shrink-0 snap-center overflow-hidden rounded-2xl border border-white/20 bg-[var(--cosmic-void)] shadow-2xl sm:w-[50vw]">
                <Image
                  src={item.src}
                  alt={screenshotAlt(index)}
                  class="h-full w-full object-cover"
                  widths={[300, 600]}
                  sizes="70vw"
                  loading={index === 0 ? 'eager' : 'lazy'}
                  fetchpriority={index === 0 ? 'high' : undefined}
                  decoding="async"
                />
              </figure>
            ))}
          </div>
          <div class="hero-carousel-controls">
            <button type="button" data-carousel-action="previous" aria-label={proofCopy.previous}>‹</button>
            <button class="hero-carousel-toggle" type="button" data-carousel-action="toggle" aria-label={proofCopy.pause}>Ⅱ</button>
            <button type="button" data-carousel-action="next" aria-label={proofCopy.next}>›</button>
          </div>
        </div>

        <div class="hidden w-full lg:block">
          <div class="relative h-[520px] w-full max-w-[1200px]">
            <div class="absolute inset-0 rounded-[3rem] bg-gradient-to-r from-[var(--hydrogen-pink)] via-[var(--carbon-purple)] to-[var(--nitrogen-cyan)] opacity-15 blur-3xl"></div>
            <div id="hero-fan-gallery" class="relative flex h-full w-full items-center justify-start">
              {screenshots.slice(0, 7).map((item, index) => {
                const position = fanPositions[index] ?? fanPositions[fanPositions.length - 1]!;
                return (
                  <button
                    class="hero-gallery-card absolute cursor-pointer border-0 bg-transparent p-0"
                    type="button"
                    data-card-index={index}
                    data-carousel-action="select"
                    tabindex={index === 0 ? '0' : '-1'}
                    aria-label={`${proofCopy.carousel}, ${index + 1}`}
                    aria-hidden={index === 0 ? 'false' : 'true'}
                    style={`transform:translate3d(${position.x}px,0,0) scale(${position.scale});opacity:${position.opacity};z-index:${position.z}`}
                  >
                    <span class="block h-[498px] w-[280px] overflow-hidden rounded-2xl border border-white/20 bg-[var(--cosmic-void)] shadow-2xl">
                      <Image
                        src={item.src}
                        alt={screenshotAlt(index)}
                        class="h-full w-full object-cover"
                        widths={[280, 560]}
                        sizes="280px"
                        loading={index === 0 ? 'eager' : 'lazy'}
                        fetchpriority={index === 0 ? 'high' : undefined}
                        decoding="async"
                      />
                    </span>
                  </button>
                );
              })}
            </div>
          </div>
          <div class="hero-carousel-controls">
            <button type="button" data-carousel-action="previous" aria-label={proofCopy.previous}>‹</button>
            <button class="hero-carousel-toggle" type="button" data-carousel-action="toggle" aria-label={proofCopy.pause}>Ⅱ</button>
            <button type="button" data-carousel-action="next" aria-label={proofCopy.next}>›</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-proof-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    width: 100%;
    max-width: 34rem;
    padding: 0.3rem;
    border-radius: 1rem;
  }

  .hero-proof-card {
    min-width: 0;
    min-height: 4.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    padding: 0.65rem 0.5rem;
    text-align: center;
  }

  .hero-proof-card:not(:last-child) {
    border-right: 1px solid rgb(255 255 255 / 0.1);
  }

  .hero-proof-card > strong,
  .hero-rating-value > strong {
    flex: 0 0 auto;
    font-size: 1.35rem;
    line-height: 1;
  }

  .hero-proof-card > span:not(.rating-stars),
  .hero-proof-card > .hero-rating-value + span {
    min-width: 0;
    color: var(--text-muted);
    font-size: 0.7rem;
    line-height: 1.3;
    text-align: center;
  }

  .hero-proof-card small {
    display: block;
    margin-top: 0.18rem;
    color: var(--text-secondary);
    font-size: 0.64rem;
  }

  .hero-rating-value {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.45rem;
  }

  .rating-stars {
    position: relative;
    display: inline-block;
    font-size: 0.7rem;
    line-height: 1;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .rating-stars-base {
    color: rgb(255 255 255 / 0.18);
  }

  .rating-stars-fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--rating-fill);
    overflow: hidden;
    color: #f5bf4f;
  }

  .hero-carousel-controls {
    display: flex;
    justify-content: center;
    gap: 0.65rem;
    margin-top: 0.5rem;
  }

  .hero-gallery-card {
    left: 0;
    transform-origin: center center;
    will-change: transform, opacity;
  }

  .hero-carousel-controls button {
    width: 2.75rem;
    height: 2.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgb(255 255 255 / 0.18);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.07);
    color: var(--text-primary);
    font-size: 1.2rem;
    line-height: 1;
    transition: background 180ms ease, transform 180ms ease;
  }

  .hero-carousel-controls button:hover {
    background: rgb(255 255 255 / 0.14);
    transform: translateY(-1px);
  }

  .hero-carousel-controls button:active {
    transform: translateY(1px);
  }

  .hero-carousel-toggle {
    font-size: 0.8rem !important;
    letter-spacing: -0.16em;
    padding-right: 0.18rem;
  }

  @media (max-width: 380px) {
    .hero-proof-card {
      padding-inline: 0.3rem;
    }

    .hero-proof-card > strong,
    .hero-rating-value > strong {
      font-size: 1.1rem;
    }

    .rating-stars {
      font-size: 0.58rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-gallery-card,
    .hero-carousel-controls button,
    #hero-mobile-gallery {
      scroll-behavior: auto !important;
      transition: none !important;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';

  (() => {
    const root = document.getElementById('hero-carousel');
    if (!root) return;

    const hero = root.closest('section');
    const desktopCards = Array.from(root.querySelectorAll<HTMLElement>('[data-card-index]'));
    const mobileGallery = root.querySelector<HTMLElement>('#hero-mobile-gallery');
    const mobileCards = mobileGallery
      ? Array.from(mobileGallery.children).filter((card): card is HTMLElement => card instanceof HTMLElement)
      : [];
    const toggles = Array.from(root.querySelectorAll<HTMLButtonElement>('.hero-carousel-toggle'));
    const introTargets = hero
      ? Array.from(hero.querySelectorAll<HTMLElement>('[data-hero-reveal]'))
      : [];
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const pauseLabel = root.dataset.pauseLabel || 'Pause carousel';
    const playLabel = root.dataset.playLabel || 'Play carousel';
    const listeners = new AbortController();
    const motion = gsap.matchMedia();
    let order = desktopCards.slice();
    let mobileIndex = 0;
    let intervalId: number | null = null;
    let resumeTimeout: number | null = null;
    let userPaused = reduceMotion.matches;
    let interactionPaused = false;
    let desktopEnabled = window.matchMedia('(min-width: 1024px)').matches;
    let motionAllowed = !reduceMotion.matches;
    let introPlayed = false;
    let carouselTimeline: gsap.core.Timeline | null = null;
    let introTimeline: gsap.core.Timeline | null = null;

    const positions = [
      { x: 0, scale: 1, opacity: 1, z: 100 },
      { x: 65, scale: 0.96, opacity: 0.93, z: 99 },
      { x: 105, scale: 0.90, opacity: 0.81, z: 98 },
      { x: 145, scale: 0.84, opacity: 0.69, z: 97 },
      { x: 185, scale: 0.78, opacity: 0.57, z: 96 },
      { x: 225, scale: 0.72, opacity: 0.45, z: 95 },
      { x: 265, scale: 0.66, opacity: 0.33, z: 94 },
    ];

    const updateDesktop = (animate = true) => {
      order.forEach((card, index) => {
        const position = positions[index] ?? positions[positions.length - 1]!;
        card.style.zIndex = String(position.z - index);
        card.tabIndex = index === 0 ? 0 : -1;
        card.setAttribute('aria-hidden', index === 0 ? 'false' : 'true');
      });

      if (!desktopEnabled) return;

      carouselTimeline?.kill();
      carouselTimeline = null;

      if (!animate || !motionAllowed) {
        order.forEach((card, index) => {
          const position = positions[index] ?? positions[positions.length - 1]!;
          gsap.set(card, {
            x: position.x,
            scale: position.scale,
            opacity: position.opacity,
          });
        });
        return;
      }

      carouselTimeline = gsap.timeline({
        defaults: { duration: 0.72, ease: 'power3.inOut', overwrite: 'auto' },
      });

      order.forEach((card, index) => {
        const position = positions[index] ?? positions[positions.length - 1]!;
        carouselTimeline?.to(card, {
          x: position.x,
          scale: position.scale,
          opacity: position.opacity,
        }, 0);
      });
    };

    const updateMobile = (behavior = 'smooth') => {
      const card = mobileCards[mobileIndex];
      if (!mobileGallery || !card) return;
      const left = card.offsetLeft - (mobileGallery.clientWidth - card.clientWidth) / 2;
      mobileGallery.scrollTo({ left, behavior: reduceMotion.matches ? 'auto' : behavior });
    };

    const step = (direction) => {
      if (order.length > 1) {
        if (direction > 0) {
          const first = order.shift();
          if (first) order.push(first);
        } else {
          const last = order.pop();
          if (last) order.unshift(last);
        }
        updateDesktop();
      }
      if (mobileCards.length > 1) {
        mobileIndex = (mobileIndex + direction + mobileCards.length) % mobileCards.length;
        updateMobile();
      }
    };

    const stop = () => {
      if (intervalId) window.clearInterval(intervalId);
      intervalId = null;
    };

    const start = () => {
      stop();
      if (userPaused || interactionPaused || document.hidden || reduceMotion.matches) return;
      intervalId = window.setInterval(() => step(1), 5000);
    };

    const updateToggle = () => {
      toggles.forEach((button) => {
        button.textContent = userPaused ? '▶' : 'Ⅱ';
        button.setAttribute('aria-label', userPaused ? playLabel : pauseLabel);
      });
    };

    root.querySelectorAll<HTMLElement>('[data-carousel-action="previous"]').forEach((button) => {
      button.addEventListener('click', () => {
        step(-1);
        start();
      }, { signal: listeners.signal });
    });

    root.querySelectorAll<HTMLElement>('[data-carousel-action="next"]').forEach((button) => {
      button.addEventListener('click', () => {
        step(1);
        start();
      }, { signal: listeners.signal });
    });

    toggles.forEach((button) => {
      button.addEventListener('click', () => {
        userPaused = !userPaused;
        updateToggle();
        start();
      }, { signal: listeners.signal });
    });

    desktopCards.forEach((card) => {
      card.addEventListener('click', () => {
        const selectedPosition = order.indexOf(card);
        if (selectedPosition <= 0) return;
        order = order.slice(selectedPosition).concat(order.slice(0, selectedPosition));
        mobileIndex = Number(card.dataset.cardIndex || 0);
        updateDesktop();
        updateMobile();
        start();
      }, { signal: listeners.signal });
    });

    const pauseForInteraction = () => {
      interactionPaused = true;
      stop();
      if (resumeTimeout) window.clearTimeout(resumeTimeout);
    };

    const resumeAfterInteraction = () => {
      if (resumeTimeout) window.clearTimeout(resumeTimeout);
      resumeTimeout = window.setTimeout(() => {
        interactionPaused = false;
        start();
      }, 5000);
    };

    root.addEventListener('pointerenter', pauseForInteraction, { signal: listeners.signal });
    root.addEventListener('pointerleave', () => {
      interactionPaused = false;
      start();
    }, { signal: listeners.signal });
    root.addEventListener('focusin', pauseForInteraction, { signal: listeners.signal });
    root.addEventListener('focusout', (event) => {
      if (event.relatedTarget instanceof Node && root.contains(event.relatedTarget)) return;
      interactionPaused = false;
      start();
    }, { signal: listeners.signal });
    mobileGallery?.addEventListener('touchstart', pauseForInteraction, { passive: true, signal: listeners.signal });
    mobileGallery?.addEventListener('touchend', resumeAfterInteraction, { passive: true, signal: listeners.signal });
    document.addEventListener('visibilitychange', start, { signal: listeners.signal });

    const handleReducedMotionChange = () => {
      userPaused = reduceMotion.matches;
      updateToggle();
      start();
    };
    reduceMotion.addEventListener?.('change', handleReducedMotionChange);

    motion.add('(min-width: 1024px)', () => {
      desktopEnabled = true;
      updateDesktop(false);

      return () => {
        desktopEnabled = false;
        carouselTimeline?.kill();
      };
    });

    motion.add('(prefers-reduced-motion: reduce)', () => {
      motionAllowed = false;
      if (desktopEnabled) updateDesktop(false);
    });

    motion.add('(prefers-reduced-motion: no-preference)', () => {
      motionAllowed = true;
      if (introPlayed) return;

      introPlayed = true;
      introTimeline = gsap.timeline({ defaults: { ease: 'power3.out' } });
      introTimeline
        .from(introTargets, {
          y: 24,
          autoAlpha: 0,
          duration: 0.72,
          stagger: 0.08,
          clearProps: 'transform,opacity,visibility',
        }, 0.05)
        .from(root, {
          x: 32,
          autoAlpha: 0,
          duration: 0.9,
          clearProps: 'transform,opacity,visibility',
        }, 0.14);
    });

    const destroy = () => {
      stop();
      if (resumeTimeout) window.clearTimeout(resumeTimeout);
      carouselTimeline?.kill();
      introTimeline?.kill();
      motion.revert();
      listeners.abort();
      reduceMotion.removeEventListener?.('change', handleReducedMotionChange);
    };

    window.addEventListener('pagehide', destroy, { once: true });

    updateToggle();
    start();
  })();
</script>
