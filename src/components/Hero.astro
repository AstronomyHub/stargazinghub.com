---
import { Image } from 'astro:assets';
import googleplayScreenshotsConfig from '../googleplay-screenshots.config.json';
import iconImage from '../assets/icon.webp';
import { getMarketingCopy } from '../i18n/marketingCopy';

const allScreenshots = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/screenshots/**/*.{webp,png,jpg}',
  { eager: true },
);

interface Props {
  t: any;
  lang?: string;
}

const { t, lang = 'en' } = Astro.props;
const screenshotPaths =
  googleplayScreenshotsConfig[lang as keyof typeof googleplayScreenshotsConfig]?.files || [];
const screenshots = screenshotPaths
  .map((path: string) => allScreenshots[path]?.default)
  .filter(Boolean);

const recognitionImage = screenshots[1] || screenshots[0];
const forecastImage = screenshots[0] || screenshots[1];
const marketingCopy = getMarketingCopy(lang);
const recognitionLabel = marketingCopy.recognitionTitle;
---

<section class="home-hero" aria-labelledby="home-title">
  <div class="hero-shell">
    <header class="hero-nav">
      <a class="brand" href="/" aria-label={`${t.brand?.name} home`}>
        <Image src={iconImage} alt="" width={44} height={44} />
        <span>
          <strong>{t.brand?.name}</strong>
          <small>{t.hero.platformLabel}</small>
        </span>
      </a>

      {lang === 'en' && (
        <a class="editorial-link" href="/press/">
          Editorial brief
          <span aria-hidden="true">↗</span>
        </a>
      )}
    </header>

    <div class="hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">{t.features?.eyebrow}</p>
        <h1 id="home-title">{t.hero.title}</h1>
        <p class="hero-subtitle">{t.hero.subtitle}</p>
        <p class="hero-description">{t.hero.description}</p>
      </div>

      {recognitionImage && (
        <figure class="hero-visual">
          <div class="visual-datum" aria-hidden="true">
            <span>01</span>
            <span>FIELD / REVIEW</span>
          </div>
          <div class="visual-well">
            {forecastImage && (
              <Image
                class="visual-secondary"
                src={forecastImage}
                alt=""
                aria-hidden="true"
                loading="eager"
                format="webp"
              />
            )}
            <Image
              class="visual-primary"
              src={recognitionImage}
              alt={`${t.brand?.name}: ${recognitionLabel}`}
              loading="eager"
              format="webp"
            />
          </div>
          <figcaption>
            <span>{recognitionLabel}</span>
            <span>{t.features?.weather?.title}</span>
          </figcaption>
        </figure>
      )}

      <div class="hero-actions" aria-label="Download Stargazing Hub">
        <a
          class="store-primary"
          href={t.links?.appStore}
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
          </svg>
          <span>
            <small>{t.download.appStore}</small>
            <strong>App Store</strong>
          </span>
        </a>
        <a
          class="store-secondary"
          href={t.links?.googlePlay}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span>
            <small>{t.download.googlePlay}</small>
            <strong>Google Play</strong>
          </span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .home-hero {
    min-height: 100svh;
    padding: 28px var(--space-page) clamp(72px, 8vw, 112px);
  }

  .hero-shell {
    width: min(var(--shell), 100%);
    margin: 0 auto;
  }

  .hero-nav {
    min-height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--hairline);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 13px;
    color: var(--limestone);
    text-decoration: none;
  }

  .brand img {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    outline: 1px solid var(--hairline-strong);
    outline-offset: -1px;
  }

  .brand span {
    display: grid;
    gap: 1px;
  }

  .brand strong {
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.012em;
  }

  .brand small {
    color: var(--quiet);
    font-size: 11px;
    line-height: 1.3;
  }

  .editorial-link {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--mist);
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    transition:
      color 180ms var(--ease-observatory),
      transform 180ms var(--ease-observatory);
  }

  .editorial-link:active {
    transform: scale(0.97);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-areas:
      'copy copy copy copy copy visual visual visual visual visual visual visual'
      'actions actions actions actions actions visual visual visual visual visual visual visual';
    gap: 32px;
    padding-top: clamp(64px, 8vw, 112px);
  }

  .hero-copy {
    grid-area: copy;
    align-self: end;
    padding-bottom: 22px;
  }

  .eyebrow {
    margin-bottom: 22px;
    color: var(--brass);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 690px;
    margin: 0;
    font-size: clamp(3.9rem, 7vw, 7.2rem);
    letter-spacing: -0.052em;
    line-height: 0.92;
  }

  .hero-subtitle {
    max-width: 560px;
    margin-top: 34px;
    color: var(--limestone);
    font-size: clamp(1.35rem, 2vw, 1.8rem);
    line-height: 1.28;
    letter-spacing: -0.012em;
  }

  .hero-description {
    max-width: 58ch;
    margin-top: 18px;
    color: var(--mist);
    font-size: 16px;
    line-height: 1.72;
  }

  .hero-visual {
    grid-area: visual;
    width: 100%;
    max-width: 590px;
    justify-self: end;
    margin: 0;
  }

  .visual-datum,
  .hero-visual figcaption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    color: var(--quiet);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.14em;
  }

  .visual-datum {
    min-height: 42px;
    border-bottom: 1px solid var(--hairline);
  }

  .visual-well {
    position: relative;
    height: min(69vw, 720px);
    min-height: 610px;
    overflow: hidden;
    background: var(--canvas-raised);
  }

  .visual-well::before,
  .visual-well::after {
    position: absolute;
    z-index: 3;
    content: '';
    pointer-events: none;
    background: var(--hairline);
  }

  .visual-well::before {
    top: 0;
    bottom: 0;
    left: 20%;
    width: 1px;
  }

  .visual-well::after {
    top: 22%;
    right: 0;
    left: 0;
    height: 1px;
  }

  .visual-primary,
  .visual-secondary {
    position: absolute;
    width: auto;
    height: auto;
    outline: 1px solid oklch(0.93 0.012 86 / 0.16);
    outline-offset: -1px;
  }

  .visual-primary {
    z-index: 2;
    top: 7%;
    right: 7%;
    width: 72%;
    max-height: 88%;
    object-fit: contain;
  }

  .visual-secondary {
    z-index: 1;
    bottom: 8%;
    left: 5%;
    width: 39%;
    opacity: 0.44;
    filter: saturate(0.72);
  }

  .hero-visual figcaption {
    min-height: 52px;
    border-top: 1px solid var(--hairline);
    letter-spacing: 0.04em;
  }

  .hero-visual figcaption span:last-child {
    color: var(--mist);
    text-align: right;
  }

  .hero-actions {
    grid-area: actions;
    align-self: start;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 18px;
    padding-top: 22px;
    border-top: 1px solid var(--hairline);
  }

  .store-primary,
  .store-secondary {
    min-height: 52px;
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    transition:
      transform 160ms var(--ease-observatory),
      background-color 200ms var(--ease-observatory),
      color 200ms var(--ease-observatory);
  }

  .store-primary {
    gap: 12px;
    padding: 0 20px;
    border-radius: var(--radius-sm);
    background: var(--brass);
    color: var(--canvas);
  }

  .store-primary svg {
    width: 24px;
    height: 24px;
  }

  .store-primary span,
  .store-secondary span:first-child {
    display: grid;
    gap: 0;
  }

  .store-primary small,
  .store-secondary small {
    font-size: 10px;
    line-height: 1.2;
    opacity: 0.72;
  }

  .store-primary strong,
  .store-secondary strong {
    font-size: 14px;
    font-weight: 600;
    line-height: 1.3;
  }

  .store-secondary {
    gap: 28px;
    padding: 0 4px 0 0;
    color: var(--mist);
  }

  .store-primary:active,
  .store-secondary:active {
    transform: scale(0.97);
  }

  @media (hover: hover) {
    .editorial-link:hover,
    .store-secondary:hover {
      color: var(--limestone);
    }

    .editorial-link:hover {
      transform: translateY(-1px);
    }

    .store-primary:hover {
      background: var(--limestone);
    }
  }

  @media (max-width: 900px) {
    .home-hero {
      padding-top: 18px;
    }

    .hero-grid {
      grid-template-columns: 1fr;
      grid-template-areas:
        'copy'
        'visual'
        'actions';
      gap: 36px;
      padding-top: 56px;
    }

    .hero-copy {
      padding-bottom: 0;
    }

    h1 {
      max-width: 760px;
      font-size: clamp(3.6rem, 12vw, 6.8rem);
    }

    .hero-visual {
      max-width: 650px;
      justify-self: start;
    }

    .visual-well {
      height: min(112vw, 720px);
      min-height: 570px;
    }

    .visual-primary {
      right: 3%;
      width: 76%;
    }
  }

  @media (max-width: 560px) {
    .hero-nav {
      min-height: 64px;
    }

    .brand small {
      max-width: 180px;
    }

    .editorial-link {
      font-size: 0;
    }

    .editorial-link span {
      font-size: 18px;
    }

    .hero-grid {
      padding-top: 48px;
    }

    h1 {
      font-size: clamp(3.1rem, 15vw, 4.7rem);
      letter-spacing: -0.042em;
    }

    .hero-subtitle {
      margin-top: 28px;
      font-size: 1.3rem;
    }

    .hero-description {
      font-size: 15px;
    }

    .visual-well {
      height: 126vw;
      min-height: 480px;
      max-height: 620px;
    }

    .visual-primary {
      top: 5%;
      right: 2%;
      width: 82%;
    }

    .visual-secondary {
      bottom: 5%;
      left: 1%;
      width: 43%;
    }

    .hero-visual figcaption {
      align-items: flex-start;
      flex-direction: column;
      justify-content: center;
      gap: 2px;
      padding: 10px 0;
    }

    .hero-visual figcaption span:last-child {
      text-align: left;
    }

    .hero-actions {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
