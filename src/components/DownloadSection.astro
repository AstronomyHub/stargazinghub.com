---
import { getAccessibilityUi } from '../i18n/marketing';

interface Props {
  t: any;
  lang?: string;
}

const { t, lang = 'en' } = Astro.props;
const a11y = getAccessibilityUi(lang);
---

<section class="home-download home-section relative overflow-hidden px-6" id="download" aria-labelledby="download-title" data-motion-section>
  <div class="home-download-orb" data-motion-orb aria-hidden="true"></div>

  <div class="relative z-10 mx-auto max-w-7xl">
    <div class="home-download-panel" data-motion-panel data-spotlight>
      <div class="home-download-copy" data-motion-header>
        <div class="home-download-kicker">{t.download.ctaLabel}</div>
        <h2 id="download-title"><span class="gradient-text">{t.download.title}</span></h2>
        <p>{t.download.subtitle}</p>
      </div>

      <div class="home-download-actions">
        <div class="home-download-bullets">
          {(t.download.bullets || []).map((bullet: string) => (
            <span data-motion-item>
              <span class="download-check" aria-hidden="true">✓</span>
              {bullet}
            </span>
          ))}
        </div>

        <div class="home-download-buttons" aria-label={a11y.downloadOptions}>
          <a
            href={t.links?.appStore}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary group flex min-w-[210px] items-center gap-4 px-9 py-4 text-lg"
            data-store="app-store"
            data-placement="download"
            data-motion-item
          >
            <svg class="h-9 w-9" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z" />
            </svg>
            <span class="text-left">
              <small class="block text-xs opacity-80">{t.download.appStore}</small>
              <strong class="block">App Store</strong>
            </span>
          </a>
          <a
            href={t.links?.googlePlay}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary group flex min-w-[210px] items-center gap-4 px-9 py-4 text-lg"
            style="--gradient-nebula:linear-gradient(135deg,#247b75 0%,#087b91 52%,#7654d9 100%)"
            data-store="google-play"
            data-placement="download"
            data-motion-item
          >
            <svg class="h-9 w-9" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M3 20.5v-17c0-.59.34-1.11.84-1.35L13.69 12l-9.85 9.85A1.5 1.5 0 0 1 3 20.5m13.81-5.38L6.05 21.34l8.49-8.49 2.27 2.27m3.35-4.31c.34.27.59.69.59 1.19s-.22.9-.57 1.18l-2.29 1.32-2.5-2.5 2.5-2.5 2.27 1.31M6.05 2.66l10.76 6.22-2.27 2.27-8.49-8.49Z" />
            </svg>
            <span class="text-left">
              <small class="block text-xs opacity-80">{t.download.googlePlay}</small>
              <strong class="block">Google Play</strong>
            </span>
          </a>
        </div>

        <p class="home-download-platforms">{t.download.platforms}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .home-download {
    padding-block: clamp(5.75rem, 8vw, 8rem);
  }

  .home-download-orb {
    position: absolute;
    top: 18%;
    left: 50%;
    width: 38rem;
    height: 24rem;
    border-radius: 50%;
    background: linear-gradient(90deg, rgb(255 107 157 / 0.09), rgb(34 211 238 / 0.075));
    filter: blur(135px);
    pointer-events: none;
    transform: translateX(-50%);
  }

  .home-download-panel {
    --spot-x: 50%;
    --spot-y: 50%;
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(24rem, 0.95fr);
    gap: clamp(2.5rem, 5vw, 5rem);
    overflow: hidden;
    padding: clamp(2.25rem, 4vw, 4rem);
    border: 1px solid rgb(255 255 255 / 0.14);
    border-radius: 1.6rem;
    background:
      radial-gradient(34rem circle at var(--spot-x) var(--spot-y), rgb(255 255 255 / 0.08), transparent 58%),
      linear-gradient(135deg, rgb(255 255 255 / 0.085), rgb(255 255 255 / 0.018) 62%),
      rgb(5 5 24 / 0.72);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.13),
      inset 0 -1px 0 rgb(255 255 255 / 0.035),
      0 34px 96px rgb(0 0 25 / 0.28);
  }

  .home-download-copy,
  .home-download-actions {
    position: relative;
    z-index: 2;
  }

  .home-download-kicker {
    color: var(--nitrogen-cyan);
    font-size: 0.78rem;
    font-weight: 650;
    letter-spacing: 0.08em;
  }

  .home-download-copy h2 {
    max-width: 38rem;
    margin-top: 1.2rem;
    font-size: clamp(2.75rem, 4.8vw, 4.5rem);
    letter-spacing: -0.06em;
    line-height: 0.96;
    text-wrap: balance;
  }

  .home-download-copy p {
    max-width: 36rem;
    margin-top: 1.5rem;
    color: var(--text-secondary);
    font-size: clamp(1.04rem, 1.6vw, 1.2rem);
    line-height: 1.7;
  }

  .home-download-actions {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .home-download-bullets {
    display: grid;
    gap: 0.9rem;
  }

  .home-download-bullets > span {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--text-secondary);
    font-size: 0.86rem;
  }

  .download-check {
    width: 1.3rem;
    height: 1.3rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: linear-gradient(135deg, var(--oxygen-blue), var(--nitrogen-cyan));
    color: #fff;
    font-size: 0.75rem;
    font-weight: 800;
  }

  .home-download-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2rem;
  }

  .home-download-buttons .btn-primary {
    min-width: 12rem;
    flex: 1 1 12rem;
    justify-content: flex-start;
    padding: 0.95rem 1.25rem;
    border-radius: 1rem;
  }

  .home-download-platforms {
    margin-top: 1.25rem;
    color: var(--text-muted);
    font-size: 0.72rem;
    line-height: 1.5;
  }

  @media (max-width: 1023px) {
    .home-download-panel {
      grid-template-columns: 1fr;
      gap: 2.75rem;
    }
  }

  @media (max-width: 640px) {
    .home-download {
      padding-block: 4.75rem;
    }

    .home-download-panel {
      padding: 2rem 1.35rem 1.5rem;
      border-radius: 1.5rem;
    }

    .home-download-copy h2 {
      font-size: clamp(2.5rem, 12vw, 3.4rem);
    }

    .home-download-buttons {
      flex-direction: column;
    }

    .home-download-buttons .btn-primary {
      width: 100%;
      min-width: 0;
      flex-basis: auto;
    }
  }
</style>
