---
import { getAccessibilityUi } from '../i18n/marketing';

interface Props {
  t: any;
  lang?: string;
}

const { t, lang = 'en' } = Astro.props;
const a11y = getAccessibilityUi(lang);
---

<section class="relative overflow-hidden px-6 py-20" id="download" aria-labelledby="download-title">
  <div class="absolute inset-0 max-w-full overflow-hidden" aria-hidden="true">
    <div class="cosmic-nebula nebula-1" style="top:-10%;left:-10%"></div>
    <div class="cosmic-nebula nebula-2" style="right:-10%;bottom:-10%"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-5xl text-center">
    <div class="glass mb-8 inline-flex max-w-full items-center rounded-full px-4 py-2 md:px-5 md:py-2.5">
      <span class="truncate text-xs font-medium text-[var(--text-secondary)] md:text-sm">{t.download.ctaLabel}</span>
    </div>
    <h2 id="download-title" class="mb-6"><span class="gradient-text">{t.download.title}</span></h2>
    <p class="mx-auto mb-10 max-w-2xl text-xl text-[var(--text-secondary)]">{t.download.subtitle}</p>

    <div class="mb-10 flex flex-wrap justify-center gap-4 sm:gap-6">
      {(t.download.bullets || []).map((bullet: string) => (
        <span class="flex items-center gap-2 text-sm text-[var(--text-secondary)]">
          <span class="download-check" aria-hidden="true">✓</span>
          {bullet}
        </span>
      ))}
    </div>

    <div class="mb-10 flex flex-col items-center justify-center gap-5 sm:flex-row" aria-label={a11y.downloadOptions}>
      <a
        href={t.links?.appStore}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary group flex min-w-[210px] items-center gap-4 px-9 py-4 text-lg"
        data-store="app-store"
        data-placement="download"
      >
        <svg class="h-9 w-9" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z" />
        </svg>
        <span class="text-left">
          <small class="block text-xs opacity-80">{t.download.appStore}</small>
          <strong class="block">App Store</strong>
        </span>
      </a>
      <a
        href={t.links?.googlePlay}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary group flex min-w-[210px] items-center gap-4 px-9 py-4 text-lg"
        style="--gradient-nebula:linear-gradient(135deg,#247b75 0%,#087b91 52%,#7654d9 100%)"
        data-store="google-play"
        data-placement="download"
      >
        <svg class="h-9 w-9" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M3 20.5v-17c0-.59.34-1.11.84-1.35L13.69 12l-9.85 9.85A1.5 1.5 0 0 1 3 20.5m13.81-5.38L6.05 21.34l8.49-8.49 2.27 2.27m3.35-4.31c.34.27.59.69.59 1.19s-.22.9-.57 1.18l-2.29 1.32-2.5-2.5 2.5-2.5 2.27 1.31M6.05 2.66l10.76 6.22-2.27 2.27-8.49-8.49Z" />
        </svg>
        <span class="text-left">
          <small class="block text-xs opacity-80">{t.download.googlePlay}</small>
          <strong class="block">Google Play</strong>
        </span>
      </a>
    </div>

    <p class="text-sm text-[var(--text-muted)]">{t.download.platforms}</p>
  </div>
</section>

<style>
  .download-check {
    width: 1.3rem;
    height: 1.3rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: linear-gradient(135deg, var(--oxygen-blue), var(--nitrogen-cyan));
    color: #fff;
    font-size: 0.75rem;
    font-weight: 800;
  }
</style>
