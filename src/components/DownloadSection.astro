---
interface Props {
  t: any;
}

const { t } = Astro.props;
---

<section class="download-section" aria-labelledby="download-title">
  <div class="download-shell">
    <div class="download-heading">
      <p class="eyebrow">{t.download.ctaLabel}</p>
      <h2 id="download-title">{t.download.title}</h2>
      <p class="subtitle">{t.download.subtitle}</p>
    </div>

    <div class="download-actions">
      <a
        class="primary-action"
        href={t.links?.appStore}
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
        </svg>
        <span>
          <small>{t.download.appStore}</small>
          <strong>App Store</strong>
        </span>
      </a>

      <a
        class="secondary-action"
        href={t.links?.googlePlay}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span>
          <small>{t.download.googlePlay}</small>
          <strong>Google Play</strong>
        </span>
        <span aria-hidden="true">↗</span>
      </a>
    </div>

    <div class="download-facts">
      {(t.download.bullets || []).map((bullet: string, index: number) => (
        <div>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <p>{bullet}</p>
        </div>
      ))}
      <div class="platform-note">
        <span>OS</span>
        <p>{t.download.platforms}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .download-section {
    padding: var(--section-space) var(--space-page);
    border-top: 1px solid var(--hairline);
    background: var(--canvas-raised);
  }

  .download-shell {
    width: min(var(--shell), 100%);
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 28px;
    margin: 0 auto;
  }

  .download-heading {
    grid-column: 1 / span 8;
  }

  .eyebrow {
    margin-bottom: 24px;
    color: var(--brass);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h2 {
    max-width: 850px;
    margin: 0;
    font-size: clamp(3rem, 6.2vw, 6.6rem);
    line-height: 0.94;
    letter-spacing: -0.048em;
  }

  .subtitle {
    max-width: 58ch;
    margin-top: 28px;
    color: var(--mist);
    font-size: 17px;
    line-height: 1.68;
  }

  .download-actions {
    grid-column: 9 / -1;
    align-self: end;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    padding-bottom: 6px;
  }

  .primary-action,
  .secondary-action {
    min-height: 54px;
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    transition:
      transform 160ms var(--ease-observatory),
      color 180ms var(--ease-observatory),
      background-color 180ms var(--ease-observatory);
  }

  .primary-action {
    gap: 12px;
    padding: 0 20px;
    border-radius: var(--radius-sm);
    background: var(--limestone);
    color: var(--canvas);
  }

  .primary-action svg {
    width: 24px;
    height: 24px;
  }

  .primary-action span,
  .secondary-action span:first-child {
    display: grid;
  }

  .primary-action small,
  .secondary-action small {
    font-size: 10px;
    line-height: 1.2;
    opacity: 0.7;
  }

  .primary-action strong,
  .secondary-action strong {
    font-size: 14px;
    font-weight: 600;
    line-height: 1.3;
  }

  .secondary-action {
    gap: 32px;
    color: var(--mist);
  }

  .primary-action:active,
  .secondary-action:active {
    transform: scale(0.97);
  }

  .download-facts {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: clamp(58px, 8vw, 104px);
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }

  .download-facts > div {
    min-height: 108px;
    padding: 22px 20px 24px;
  }

  .download-facts > div + div {
    border-left: 1px solid var(--hairline);
  }

  .download-facts span {
    color: var(--brass);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.12em;
  }

  .download-facts p {
    margin-top: 14px;
    color: var(--mist);
    font-size: 13px;
    line-height: 1.55;
  }

  @media (hover: hover) {
    .primary-action:hover {
      background: var(--brass);
    }

    .secondary-action:hover {
      color: var(--limestone);
    }
  }

  @media (max-width: 860px) {
    .download-shell {
      grid-template-columns: 1fr;
    }

    .download-heading,
    .download-actions,
    .download-facts {
      grid-column: auto;
    }

    .download-actions {
      margin-top: 18px;
    }

    .download-facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .download-facts > div:nth-child(3) {
      border-left: 0;
      border-top: 1px solid var(--hairline);
    }

    .download-facts > div:nth-child(4) {
      border-top: 1px solid var(--hairline);
    }
  }

  @media (max-width: 520px) {
    h2 {
      font-size: clamp(3rem, 14vw, 4.3rem);
    }

    .download-facts {
      grid-template-columns: 1fr;
    }

    .download-facts > div + div {
      border-top: 1px solid var(--hairline);
      border-left: 0;
    }

    .download-facts > div {
      min-height: auto;
      padding-right: 0;
      padding-left: 0;
    }
  }
</style>
