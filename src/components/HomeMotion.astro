<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  (() => {
    const root = document.querySelector<HTMLElement>('body.home-page main');
    if (!root) return;

    const motion = gsap.matchMedia();
    const listeners = new AbortController();
    const spotlightCards = Array.from(root.querySelectorAll<HTMLElement>('[data-spotlight]'));

    spotlightCards.forEach((card) => {
      card.addEventListener('pointermove', (event) => {
        const bounds = card.getBoundingClientRect();
        card.style.setProperty('--spot-x', `${event.clientX - bounds.left}px`);
        card.style.setProperty('--spot-y', `${event.clientY - bounds.top}px`);
      }, { signal: listeners.signal });

      card.addEventListener('pointerleave', () => {
        card.style.removeProperty('--spot-x');
        card.style.removeProperty('--spot-y');
      }, { signal: listeners.signal });
    });

    motion.add(
      {
        isDesktop: '(min-width: 1024px)',
        reduceMotion: '(prefers-reduced-motion: reduce)',
      },
      (context) => {
        const conditions = context.conditions as { isDesktop: boolean; reduceMotion: boolean };
        if (conditions.reduceMotion) return;

        const animationContext = gsap.context(() => {
          const sections = Array.from(root.querySelectorAll<HTMLElement>('[data-motion-section]'));

          sections.forEach((section) => {
            const header = section.querySelector<HTMLElement>('[data-motion-header]');
            const panels = Array.from(section.querySelectorAll<HTMLElement>('[data-motion-panel]'))
              .filter((panel) => panel.offsetParent !== null);
            const items = Array.from(section.querySelectorAll<HTMLElement>('[data-motion-item]'))
              .filter((item) => item.offsetParent !== null);

            const timeline = gsap.timeline({
              defaults: { ease: 'power2.out' },
              scrollTrigger: {
                trigger: section,
                start: conditions.isDesktop ? 'top 72%' : 'top 84%',
                once: true,
                invalidateOnRefresh: true,
              },
            });

            if (header) {
              timeline.from(header, {
                y: conditions.isDesktop ? 26 : 18,
                opacity: 0,
                duration: 0.72,
                clearProps: 'transform,opacity',
              });
            }

            if (panels.length > 0) {
              timeline.from(panels, {
                y: conditions.isDesktop ? 30 : 22,
                scale: 0.992,
                opacity: 0,
                duration: 0.8,
                stagger: 0.08,
                clearProps: 'transform,opacity',
              }, header ? '-=0.46' : 0);
            }

            if (items.length > 0) {
              timeline.from(items, {
                y: conditions.isDesktop ? 18 : 14,
                opacity: 0,
                duration: 0.58,
                stagger: conditions.isDesktop ? 0.04 : 0.03,
                clearProps: 'transform,opacity',
              }, panels.length > 0 ? '-=0.48' : header ? '-=0.38' : 0);
            }

            section.querySelectorAll<HTMLElement>('[data-motion-orb]').forEach((orb) => {
              gsap.fromTo(orb, { yPercent: -3 }, {
                yPercent: 6,
                ease: 'none',
                scrollTrigger: {
                  trigger: section,
                  start: 'top bottom',
                  end: 'bottom top',
                  scrub: 1.6,
                },
              });
            });
          });
        }, root);

        requestAnimationFrame(() => ScrollTrigger.refresh());

        return () => animationContext.revert();
      },
    );

    const destroy = () => {
      motion.revert();
      listeners.abort();
    };

    window.addEventListener('pagehide', destroy, { once: true });
  })();
</script>

