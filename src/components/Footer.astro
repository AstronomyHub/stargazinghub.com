---
import { Image } from 'astro:assets';
import icon from '../assets/icon.webp';
import { getCompass, compassPath } from '../data/compassContent';
import { getAccessibilityUi, getMarketingUi } from '../i18n/marketing';
import { websiteLocales } from '../data/appKnowledge';
interface Props { t: any; lang: string; }
const { t, lang } = Astro.props;
const ui = getMarketingUi(lang);
const a11y = getAccessibilityUi(lang);
const locale = websiteLocales.find((item) => item.code === lang) || websiteLocales[0];
const compassLabel = getCompass(lang).title.split(/[:：·]/)[0].trim();
const socials = [
  { name: 'X', href: 'https://x.com/lpm_app' },
  { name: 'Bluesky', href: 'https://bsky.app/profile/lightpollutionmap.app' },
  { name: 'Facebook', href: 'https://www.facebook.com/StargazingHub' },
];
---
<footer class="night-footer">
  <div class="night-container">
    <div class="night-footer-top">
      <div><a class="night-brand" href={locale.path}><Image src={icon} alt="" width={34} height={34} />{t.brand.name}</a><p>{t.footer.description}</p><nav class="night-socials" aria-label={a11y.socialLinks}>{socials.map((social) => <a href={social.href} target="_blank" rel="noopener noreferrer">{social.name}<span aria-hidden="true">↗</span></a>)}</nav></div>
      <nav class="night-footer-links" aria-label={a11y.footerNavigation}>
        <a href="/features/">{t.navbar.features}</a><a href="/faq/">FAQ</a><a href={compassPath(lang)}>{compassLabel}</a>
        {lang === 'en' && <a href="/press/">Press</a>}<a href="mailto:support@stargazinghub.com">{ui.support}</a><a href="/privacy/">{t.footer.privacy}</a><a href="/terms/">{t.footer.terms}</a>
      </nav>
      <button type="button" class="night-language-trigger" data-language-open aria-haspopup="dialog" aria-controls="language-picker">{locale.name}<span aria-hidden="true">⌄</span></button>
    </div>
    <p class="night-copyright">© {new Date().getFullYear()} {t.brand.name}{lang.startsWith('zh') ? '。' : '. '}{t.footer.copyright}</p>
  </div>
</footer>
