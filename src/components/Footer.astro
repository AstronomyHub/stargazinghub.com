---
import { Image } from 'astro:assets';
import iconImage from '../assets/icon.webp';
import { getCompass, compassPath } from '../data/compassContent';

interface Props {
  t: any;
  lang: string;
}

const { t, lang } = Astro.props;
const year = new Date().getFullYear();
const compassLabel = getCompass(lang).title.split(/[:：·—]/)[0].trim();
---

<footer>
  <div class="footer-shell">
    <div class="footer-main">
      <div class="footer-brand">
        <a href="/" aria-label={`${t.brand?.name} home`}>
          <Image src={iconImage} alt="" width={42} height={42} />
          <strong>{t.brand?.name}</strong>
        </a>
        <p>{t.footer.description}</p>
      </div>

      <nav class="footer-links" aria-label="Product and legal">
        <div>
          <span>Product</span>
          <a href={t.links?.appStore} target="_blank" rel="noopener noreferrer">App Store</a>
          <a href={t.links?.googlePlay} target="_blank" rel="noopener noreferrer">Google Play</a>
          {lang === 'en' && <a href="/press/">Editorial brief</a>}
        </div>
        <div>
          <span>Information</span>
          <a href="/privacy">{t.footer.privacy}</a>
          <a href="/terms">{t.footer.terms}</a>
          <a href={compassPath(lang)}>{compassLabel}</a>
        </div>
      </nav>
    </div>

    <div class="footer-bottom">
      <p>&copy; {year} {t.brand?.name}. {t.footer.copyright}</p>

      <div class="language">
        <label for="language-selector">Language</label>
        <select
          id="language-selector"
          aria-label="Select language / 选择语言"
          onchange="localStorage.setItem('preferred_path', this.value); window.location.href=this.value"
        >
          <option value="/" selected={lang === 'en'}>English</option>
          <option value="/zh/" selected={lang === 'zh'}>简体中文</option>
          <option value="/zh-tw/" selected={lang === 'zh-tw'}>繁體中文</option>
          <option value="/ja/" selected={lang === 'ja'}>日本語</option>
          <option value="/ko/" selected={lang === 'ko'}>한국어</option>
          <option value="/de/" selected={lang === 'de'}>Deutsch</option>
          <option value="/fr/" selected={lang === 'fr'}>Français</option>
          <option value="/es/" selected={lang === 'es'}>Español</option>
          <option value="/it/" selected={lang === 'it'}>Italiano</option>
          <option value="/ru/" selected={lang === 'ru'}>Русский</option>
          <option value="/nl/" selected={lang === 'nl'}>Nederlands</option>
          <option value="/pl/" selected={lang === 'pl'}>Polski</option>
        </select>
      </div>
    </div>
  </div>
</footer>

<style>
  footer {
    padding: clamp(72px, 9vw, 116px) var(--space-page) 32px;
    border-top: 1px solid var(--hairline);
  }

  .footer-shell {
    width: min(var(--shell), 100%);
    margin: 0 auto;
  }

  .footer-main {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 24px;
    padding-bottom: clamp(64px, 8vw, 96px);
  }

  .footer-brand {
    grid-column: 1 / span 6;
  }

  .footer-brand > a {
    display: inline-flex;
    align-items: center;
    gap: 13px;
    color: var(--limestone);
    text-decoration: none;
  }

  .footer-brand img {
    width: 42px;
    height: 42px;
    border-radius: 9px;
    outline: 1px solid var(--hairline);
    outline-offset: -1px;
  }

  .footer-brand strong {
    font-size: 17px;
    font-weight: 600;
  }

  .footer-brand p {
    max-width: 45ch;
    margin-top: 24px;
    color: var(--quiet);
    font-size: 14px;
    line-height: 1.7;
  }

  .footer-links {
    grid-column: 8 / -1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 40px;
  }

  .footer-links > div {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }

  .footer-links span {
    margin-bottom: 8px;
    color: var(--quiet);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .footer-links a {
    min-height: 32px;
    display: inline-flex;
    align-items: center;
    color: var(--mist);
    font-size: 13px;
    text-decoration: none;
    transition: color 160ms var(--ease-observatory);
  }

  .footer-bottom {
    min-height: 66px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 28px;
    padding-top: 26px;
    border-top: 1px solid var(--hairline);
  }

  .footer-bottom > p {
    color: var(--quiet);
    font-size: 12px;
  }

  .language {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .language label {
    color: var(--quiet);
    font-size: 11px;
  }

  .language select {
    min-height: 40px;
    padding: 0 30px 0 12px;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-sm);
    background: var(--canvas);
    color: var(--mist);
    font-size: 12px;
    cursor: pointer;
  }

  @media (hover: hover) {
    .footer-links a:hover {
      color: var(--limestone);
    }
  }

  @media (max-width: 760px) {
    .footer-main {
      grid-template-columns: 1fr;
      gap: 56px;
    }

    .footer-brand,
    .footer-links {
      grid-column: auto;
    }

    .footer-bottom {
      align-items: flex-start;
      flex-direction: column-reverse;
    }
  }
</style>
