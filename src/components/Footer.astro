---
import { Image } from 'astro:assets';
import iconImage from '../assets/icon.webp';
import { getCompass, compassPath } from '../data/compassContent';

interface Props {
  t: any;
  lang: string;
}

const { t, lang } = Astro.props;
const year = new Date().getFullYear();
const compassLabel = getCompass(lang).title.split(/[:：·—]/)[0].trim();

const socialLinks = [
  {
    name: 'App Store',
    href: t.links?.appStore || 'https://apps.apple.com/us/app/stargazing-hub-sky-live/id1478601599',
    icon: `<svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
    </svg>`
  },
  {
    name: 'Google Play',
    href: t.links?.googlePlay || 'https://play.google.com/store/apps/details?id=com.twtapp&hl=en',
    icon: `<svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M3,20.5V3.5C3,2.91 3.34,2.39 3.84,2.15L13.69,12L3.84,21.85C3.34,21.6 3,21.09 3,20.5M16.81,15.12L6.05,21.34L14.54,12.85L16.81,15.12M20.16,10.81C20.5,11.08 20.75,11.5 20.75,12C20.75,12.5 20.53,12.9 20.18,13.18L17.89,14.5L15.39,12L17.89,9.5L20.16,10.81M6.05,2.66L16.81,8.88L14.54,11.15L6.05,2.66Z" />
    </svg>`
  },
  {
    name: 'X',
    href: 'https://x.com/lpm_app',
    icon: `<svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231 5.451-6.231Zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77Z"/>
    </svg>`
  },
  {
    name: 'Bluesky',
    href: 'https://bsky.app/profile/lightpollutionmap.app',
    icon: `<svg class="w-5 h-5" viewBox="0 0 64 57" fill="currentColor" aria-hidden="true">
      <path d="M13.873 3.805C21.21 9.332 29.103 20.537 32 26.55v15.882c0-.338-.13.044-.41.867-1.512 4.456-7.418 21.847-20.923 7.944-7.111-7.32-3.819-14.64 9.125-16.85-7.405 1.264-15.73-.825-18.014-9.015C1.12 23.022 0 8.51 0 6.55 0-3.268 8.579-.182 13.873 3.805ZM50.127 3.805C42.79 9.332 34.897 20.537 32 26.55v15.882c0-.338.13.044.41.867 1.512 4.456 7.418 21.847 20.923 7.944 7.111-7.32 3.819-14.64-9.125-16.85 7.405 1.264 15.73-.825 18.014-9.015C62.88 23.022 64 8.51 64 6.55c0-9.818-8.578-6.732-13.873-2.745Z"/>
    </svg>`
  },
  {
    name: 'Facebook',
    href: 'https://www.facebook.com/StargazingHub',
    icon: `<svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.438H7.078v-3.489h3.047V9.414c0-3.025 1.792-4.697 4.533-4.697 1.312 0 2.686.236 2.686.236v2.973h-1.513c-1.49 0-1.956.931-1.956 1.887v2.26h3.328l-.532 3.489h-2.796V24C19.612 23.094 24 18.1 24 12.073Z"/>
    </svg>`
  }
];
---

<footer class="relative border-t border-[var(--glass-border)]">
  <div class="max-w-7xl mx-auto px-6 py-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 items-center mb-12">
      <!-- Logo & Description -->
      <div class="text-center md:text-left">
        <div class="flex items-center justify-center md:justify-start gap-3 mb-4">
          <div class="relative">
            <div class="absolute inset-0 bg-gradient-to-r from-[var(--hydrogen-pink)] to-[var(--nitrogen-cyan)] rounded-xl blur-lg opacity-50"></div>
            <Image src={iconImage} alt={t.brand?.name} class="relative w-12 h-12 rounded-xl" />
          </div>
          <span class="font-bold text-xl">{t.brand?.name}</span>
        </div>
        <p class="text-[var(--text-secondary)] text-sm mb-6 max-w-xs leading-relaxed">
          {t.footer.description}
        </p>
        <!-- 社交链接 -->
        <div class="flex gap-3 justify-center md:justify-start">
          {
            socialLinks.map(link => (
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="w-10 h-10 glass rounded-lg flex items-center justify-center hover:bg-[var(--hydrogen-pink)]/20 transition-all duration-300"
                aria-label={link.name}
                set:html={link.icon}
              />
            ))
          }
        </div>
      </div>

      <!-- 法律链接 -->
      <div class="flex flex-col sm:flex-row gap-6 justify-center items-center">
        <a
          href="/privacy"
          class="text-[var(--text-secondary)] hover:text-[var(--hydrogen-pink)] transition-colors text-sm"
        >
          {t.footer.privacy}
        </a>
        <a
          href="/terms"
          class="text-[var(--text-secondary)] hover:text-[var(--hydrogen-pink)] transition-colors text-sm"
        >
          {t.footer.terms}
        </a>
        {lang === 'en' && (
          <a
            href="/press/"
            class="text-[var(--text-secondary)] hover:text-[var(--hydrogen-pink)] transition-colors text-sm"
          >
            Press
          </a>
        )}
        <a
          href={compassPath(lang)}
          class="text-[var(--text-secondary)] hover:text-[var(--hydrogen-pink)] transition-colors text-sm"
        >
          {compassLabel}
        </a>
      </div>

      <!-- 状态指示 -->
      {t.footer.status && (
      <div class="flex justify-center md:justify-end">
        <div class="flex items-center gap-3 px-5 py-2.5 rounded-full glass">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[var(--oxygen-blue)] opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-[var(--oxygen-blue)]"></span>
          </span>
          <span class="text-sm text-[var(--text-secondary)]">{t.footer.status}</span>
        </div>
      </div>
      )}
    </div>

    <!-- 底部版权 -->
    <div class="pt-8 border-t border-[var(--glass-border)] flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="w-full max-w-full text-center text-[var(--text-muted)] text-sm md:w-auto md:text-left">
        &copy; {year} {t.brand?.name}. {t.footer.copyright}
      </p>

      <!-- 语言选择器 -->
      <div class="flex items-center gap-3">
        <label for="language-selector" class="text-[var(--text-muted)] text-sm"><span aria-hidden="true">🌐</span></label>
        <select
          id="language-selector"
          class="bg-[var(--glass-bg)] border border-[var(--glass-border)] text-[var(--text-secondary)] text-sm rounded-lg px-3 py-1.5 focus:outline-none focus:border-[var(--hydrogen-pink)] cursor-pointer hover:border-[var(--hydrogen-pink)]/50 transition-colors"
          aria-label="Select language / 选择语言"
          onchange="localStorage.setItem('preferred_path', this.value); window.location.href=this.value"
        >
          <option value="/" selected={lang === 'en'}>English</option>
          <option value="/zh/" selected={lang === 'zh'}>简体中文</option>
          <option value="/zh-tw/" selected={lang === 'zh-tw'}>繁體中文</option>
          <option value="/ja/" selected={lang === 'ja'}>日本語</option>
          <option value="/ko/" selected={lang === 'ko'}>한국어</option>
          <option value="/de/" selected={lang === 'de'}>Deutsch</option>
          <option value="/fr/" selected={lang === 'fr'}>Français</option>
          <option value="/es/" selected={lang === 'es'}>Español</option>
          <option value="/it/" selected={lang === 'it'}>Italiano</option>
          <option value="/ru/" selected={lang === 'ru'}>Русский</option>
          <option value="/nl/" selected={lang === 'nl'}>Nederlands</option>
          <option value="/pl/" selected={lang === 'pl'}>Polski</option>
        </select>
      </div>
    </div>
  </div>
</footer>
