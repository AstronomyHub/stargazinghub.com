---
import { getMarketingUi } from '../i18n/marketing';

interface Props {
  t: any;
  lang?: string;
}

const { t, lang = 'en' } = Astro.props;
const ui = getMarketingUi(lang);

const featureHref = (slug: string) => {
  if (lang === 'zh' && slug === 'stargazing-forecast') {
    return '/zh/features/stargazing-forecast/';
  }
  if (lang === 'it' && slug === 'light-pollution-map') {
    return '/it/features/light-pollution-map/';
  }
  return `/features/${slug}/`;
};

const features = [
  {
    key: 'weather',
    slug: 'stargazing-forecast',
    gradient: 'from-[var(--oxygen-blue)] to-[var(--nitrogen-cyan)]',
    icon: '<path d="M17.5 19c0-3.04-2.46-5.5-5.5-5.5S6.5 15.96 6.5 19"/><circle cx="12" cy="10" r="3"/><path d="M8 10V7a4 4 0 0 1 8 0v3M12 2v2M4.22 5.22l1.42 1.42M1 12h2M19.78 5.22l-1.42 1.42M21 12h2"/>',
  },
  {
    key: 'satellite',
    slug: 'light-pollution-map',
    gradient: 'from-[var(--hydrogen-pink)] to-[var(--carbon-purple)]',
    icon: '<circle cx="12" cy="12" r="10"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10zM2 12h20"/>',
  },
  {
    key: 'starMap',
    slug: 'sky-map',
    gradient: 'from-[var(--carbon-purple)] to-[var(--oxygen-blue)]',
    icon: '<path d="M12 2 2 7l10 5 10-5-10-5ZM2 17l10 5 10-5M2 12l10 5 10-5"/><circle cx="12" cy="12" r="2" fill="currentColor"/>',
  },
  {
    key: 'free',
    slug: 'sky-recognition',
    gradient: 'from-[var(--nitrogen-cyan)] to-[var(--oxygen-blue)]',
    icon: '<path d="M4 8V4h4M16 4h4v4M20 16v4h-4M8 20H4v-4"/><path d="m8 15 2.5-3 2 2 1.5-2 2 3H8Z"/><circle cx="9" cy="9" r="1" fill="currentColor"/>',
  },
  {
    key: 'aurora',
    slug: 'aurora-forecast',
    gradient: 'from-[var(--oxygen-blue)] to-[var(--carbon-purple)]',
    icon: '<path d="M3 17c3-8 6 4 9-5s6 3 9-5M3 21c3-6 6 3 9-4s6 2 9-4"/><path d="M5 4h.01M12 2h.01M19 4h.01"/>',
  },
  {
    key: 'solar',
    slug: '3d-moon',
    gradient: 'from-[var(--sulfur-gold)] to-[var(--oxygen-blue)]',
    icon: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>',
  },
  {
    key: 'meteor',
    slug: 'meteor-shower-calendar',
    gradient: 'from-[var(--sulfur-gold)] to-[var(--hydrogen-pink)]',
    icon: '<path d="m14 4-2.2 4.8L7 11l4.8 2.2L14 18l2.2-4.8L21 11l-4.8-2.2L14 4Z"/><path d="M3 4h5M2 8h6M4 12h3"/>',
  },
  {
    key: 'tools',
    slug: 'astrophotography-tools',
    gradient: 'from-[var(--hydrogen-pink)] to-[var(--sulfur-gold)]',
    icon: '<circle cx="12" cy="12" r="3"/><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>',
  },
] as const;
---

<section class="relative overflow-hidden px-6 py-20" id="features" aria-labelledby="home-features-title">
  <div class="mx-auto max-w-7xl">
    <header class="mb-12 text-center">
      <div class="glass mb-6 inline-flex max-w-full items-center gap-2 rounded-full px-3 py-1.5 md:px-4 md:py-2">
        <span class="text-xs text-[var(--text-secondary)] md:text-sm">{t.features.eyebrow}</span>
      </div>
      <h2 id="home-features-title" class="mb-4">
        <span class="gradient-text-cool">{t.features.title}</span>
      </h2>
      <p class="mx-auto max-w-2xl text-base leading-relaxed text-[var(--text-secondary)]">
        {t.features.subtitle}
      </p>
    </header>

    <div class="hidden grid-cols-1 gap-6 md:grid-cols-2 lg:grid lg:grid-cols-4">
      {features.map((feature, index) => (
        <a
          href={featureHref(feature.slug)}
          class="glass-card group relative overflow-hidden p-6 no-underline"
          data-feature={feature.slug}
          data-placement="home-grid"
          style={`animation-delay:${index * 0.08}s`}
        >
          <span class={`absolute inset-0 bg-gradient-to-br ${feature.gradient} opacity-0 transition-opacity duration-500 group-hover:opacity-10`}></span>
          <span class="relative block">
            <span class={`mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br ${feature.gradient} shadow-lg transition-transform duration-300 group-hover:-translate-y-1`}>
              <svg class="h-8 w-8 text-white" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={feature.icon}></svg>
            </span>
            <strong class="mb-2 block text-lg text-white transition-colors duration-300 group-hover:text-[var(--hydrogen-pink)]">
              {t.features[feature.key].title}
            </strong>
            <span class="block text-sm leading-relaxed text-[var(--text-secondary)]">
              {t.features[feature.key].description}
            </span>
          </span>
        </a>
      ))}
    </div>

    <div class="no-scrollbar -mx-6 grid snap-x snap-mandatory grid-flow-col grid-rows-2 gap-4 overflow-x-auto px-6 pb-6 lg:hidden">
      {features.map((feature) => (
        <a
          href={featureHref(feature.slug)}
          class="glass-card group relative flex h-full w-[70vw] snap-start items-center overflow-hidden p-5 no-underline sm:w-[300px]"
          data-feature={feature.slug}
          data-placement="home-grid-mobile"
        >
          <span class={`absolute inset-0 bg-gradient-to-br ${feature.gradient} opacity-5`}></span>
          <span class="relative flex items-start gap-4">
            <span class={`flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-gradient-to-br ${feature.gradient} shadow-lg`}>
              <svg class="h-6 w-6 text-white" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={feature.icon}></svg>
            </span>
            <span>
              <strong class="mb-1 block text-base leading-tight text-white">{t.features[feature.key].title}</strong>
              <span class="line-clamp-2 block text-xs leading-relaxed text-[var(--text-secondary)]">{t.features[feature.key].description}</span>
            </span>
          </span>
        </a>
      ))}
    </div>

    <div class="mt-12 grid grid-cols-2 gap-4 md:grid-cols-4">
      {Object.values(t.features.stats || {}).map((stat: any, index: number) => (
        <div class="glass-card p-5 text-center">
          <strong class:list={[
            'mb-1 block text-xl md:text-2xl',
            index % 3 === 0 ? 'gradient-text-warm' : index % 3 === 1 ? 'gradient-text-cool' : 'gradient-text',
          ]}>{stat.value}</strong>
          <span class="text-xs text-[var(--text-muted)]">{stat.label}</span>
        </div>
      ))}
    </div>

    <div class="mt-9 text-center">
      <a class="text-sm font-semibold text-[var(--nitrogen-cyan)] hover:text-white" href="/features/" data-feature="all" data-placement="home-grid">
        {ui.allFeatures}
      </a>
    </div>
  </div>
</section>
