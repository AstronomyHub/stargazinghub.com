---
import { Image } from 'astro:assets';
import googleplayScreenshotsConfig from '../googleplay-screenshots.config.json';
import { getMarketingCopy } from '../i18n/marketingCopy';

const allScreenshots = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/screenshots/**/*.{webp,png,jpg}',
  { eager: true },
);

interface Props {
  t: any;
  lang?: string;
}

const { t, lang = 'en' } = Astro.props;
const screenshotPaths =
  googleplayScreenshotsConfig[lang as keyof typeof googleplayScreenshotsConfig]?.files || [];
const screenshots = screenshotPaths
  .map((path: string) => allScreenshots[path]?.default)
  .filter(Boolean);

const marketingCopy = getMarketingCopy(lang);

const workflow = [
  {
    number: '01',
    title: t.features.weather.title,
    description: t.features.weather.description,
    image: screenshots[0] || screenshots[3],
  },
  {
    number: '02',
    title: marketingCopy.recognitionTitle,
    description: marketingCopy.recognitionDescription,
    image: screenshots[1] || screenshots[0],
  },
  {
    number: '03',
    title: t.features.starMap.title,
    description: t.features.starMap.description,
    image: screenshots[2] || screenshots[1],
  },
  {
    number: '04',
    title: t.features.stats?.bortle?.label || t.features.stats?.bortle?.value,
    description: marketingCopy.lightPollutionDescription,
    image: screenshots[3] || screenshots[0],
  },
];

const toolIndex = ['satellite', 'meteor', 'solar', 'tools'];
---

<section class="workflow-section" aria-labelledby="workflow-title">
  <div class="section-shell">
    <header class="section-heading">
      <p class="eyebrow">{t.features.eyebrow}</p>
      <h2 id="workflow-title">{t.features.title}</h2>
      <p>{t.features.subtitle}</p>
    </header>

    <div class="workflow-bays">
      {workflow.map((item) => (
        <article class="workflow-bay">
          <div class="bay-copy">
            <span class="bay-number">{item.number}</span>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </div>
          {item.image && (
            <figure>
              <Image
                src={item.image}
                alt={`${t.brand?.name}: ${item.title}`}
                loading="lazy"
                format="webp"
              />
            </figure>
          )}
        </article>
      ))}
    </div>

    <div class="tool-index">
      <div class="index-heading">
        <span>05-08</span>
        <p>{t.features.eyebrow}</p>
      </div>
      <div class="index-list">
        {toolIndex.map((key, index) => (
          <article>
            <span>{String(index + 5).padStart(2, '0')}</span>
            <div>
              <h3>{t.features[key].title}</h3>
              <p>{t.features[key].description}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .workflow-section {
    padding: var(--section-space) var(--space-page);
    border-top: 1px solid var(--hairline);
  }

  .section-shell {
    width: min(var(--shell), 100%);
    margin: 0 auto;
  }

  .section-heading {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 24px;
    align-items: end;
    padding-bottom: clamp(56px, 7vw, 92px);
  }

  .eyebrow {
    grid-column: 1 / span 3;
    align-self: start;
    color: var(--brass);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .section-heading h2 {
    grid-column: 4 / span 6;
    margin: 0;
    font-size: clamp(3rem, 5.4vw, 5.7rem);
    line-height: 0.96;
    letter-spacing: -0.044em;
  }

  .section-heading > p:last-child {
    grid-column: 10 / span 3;
    max-width: 31ch;
    color: var(--mist);
    font-size: 15px;
    line-height: 1.7;
  }

  .workflow-bays {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }

  .workflow-bay {
    min-width: 0;
    display: grid;
    grid-template-rows: minmax(245px, auto) 1fr;
    padding: 28px 24px 0;
  }

  .workflow-bay + .workflow-bay {
    border-left: 1px solid var(--hairline);
  }

  .bay-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .bay-number {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    margin-bottom: 28px;
    color: var(--brass);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
  }

  .bay-copy h3 {
    margin: 0;
    font-size: clamp(1.35rem, 2vw, 1.8rem);
    line-height: 1.12;
  }

  .bay-copy p {
    max-width: 29ch;
    margin-top: 14px;
    color: var(--mist);
    font-size: 14px;
    line-height: 1.65;
  }

  .workflow-bay figure {
    align-self: end;
    margin: 34px 0 0;
    overflow: hidden;
    background: var(--canvas-raised);
  }

  .workflow-bay img {
    width: 100%;
    height: auto;
    outline: 1px solid oklch(0.93 0.012 86 / 0.1);
    outline-offset: -1px;
    transition:
      transform 520ms var(--ease-observatory),
      filter 520ms var(--ease-observatory);
  }

  .tool-index {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 24px;
    padding-top: clamp(72px, 9vw, 124px);
  }

  .index-heading {
    grid-column: 1 / span 3;
    color: var(--quiet);
  }

  .index-heading span {
    color: var(--brass);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
  }

  .index-heading p {
    max-width: 18ch;
    margin-top: 14px;
    font-size: 14px;
  }

  .index-list {
    grid-column: 4 / -1;
  }

  .index-list article {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 20px;
    padding: 24px 0 27px;
    border-top: 1px solid var(--hairline);
  }

  .index-list article:last-child {
    border-bottom: 1px solid var(--hairline);
  }

  .index-list article > span {
    padding-top: 3px;
    color: var(--quiet);
    font-size: 11px;
    letter-spacing: 0.12em;
  }

  .index-list h3 {
    margin: 0;
    font-size: clamp(1.25rem, 2vw, 1.65rem);
  }

  .index-list p {
    max-width: 66ch;
    margin-top: 8px;
    color: var(--mist);
    font-size: 14px;
    line-height: 1.65;
  }

  @media (hover: hover) {
    .workflow-bay:hover img {
      transform: scale(1.012);
      filter: brightness(1.05);
    }
  }

  @media (max-width: 980px) {
    .section-heading {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .eyebrow,
    .section-heading h2,
    .section-heading > p:last-child {
      grid-column: auto;
    }

    .section-heading > p:last-child {
      max-width: 58ch;
    }

    .workflow-bays {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .workflow-bay:nth-child(3) {
      border-left: 0;
      border-top: 1px solid var(--hairline);
    }

    .workflow-bay:nth-child(4) {
      border-top: 1px solid var(--hairline);
    }

    .tool-index {
      grid-template-columns: 1fr;
    }

    .index-heading,
    .index-list {
      grid-column: auto;
    }

    .index-heading p {
      max-width: none;
    }
  }

  @media (max-width: 620px) {
    .section-heading h2 {
      font-size: clamp(2.8rem, 13vw, 4rem);
    }

    .workflow-bays {
      grid-template-columns: 1fr;
    }

    .workflow-bay {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      grid-template-rows: auto;
      gap: 18px;
      align-items: end;
      padding: 28px 0 0;
      border-top: 1px solid var(--hairline);
    }

    .workflow-bay:first-child {
      border-top: 0;
    }

    .workflow-bay + .workflow-bay {
      border-left: 0;
    }

    .bay-copy {
      align-self: start;
      padding-bottom: 28px;
    }

    .bay-number {
      margin-bottom: 22px;
    }

    .bay-copy p {
      font-size: 13px;
    }

    .workflow-bay figure {
      margin-top: 0;
    }

    .index-list article {
      grid-template-columns: 42px 1fr;
    }
  }
</style>
