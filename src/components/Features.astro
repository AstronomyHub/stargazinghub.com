---
import { getMarketingUi } from '../i18n/marketing';

interface Props {
  t: any;
  lang?: string;
}

const { t, lang = 'en' } = Astro.props;
const ui = getMarketingUi(lang);

const featureHref = (slug: string) => {
  if (lang === 'zh' && slug === 'stargazing-forecast') {
    return '/zh/features/stargazing-forecast/';
  }
  if (lang === 'it' && slug === 'light-pollution-map') {
    return '/it/features/light-pollution-map/';
  }
  return `/features/${slug}/`;
};

const features = [
  {
    key: 'weather',
    slug: 'stargazing-forecast',
    gradient: 'from-[var(--oxygen-blue)] to-[var(--nitrogen-cyan)]',
    icon: '<path d="M17.5 19c0-3.04-2.46-5.5-5.5-5.5S6.5 15.96 6.5 19"/><circle cx="12" cy="10" r="3"/><path d="M8 10V7a4 4 0 0 1 8 0v3M12 2v2M4.22 5.22l1.42 1.42M1 12h2M19.78 5.22l-1.42 1.42M21 12h2"/>',
  },
  {
    key: 'satellite',
    slug: 'light-pollution-map',
    gradient: 'from-[var(--hydrogen-pink)] to-[var(--carbon-purple)]',
    icon: '<circle cx="12" cy="12" r="10"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10zM2 12h20"/>',
  },
  {
    key: 'starMap',
    slug: 'sky-map',
    gradient: 'from-[var(--carbon-purple)] to-[var(--oxygen-blue)]',
    icon: '<path d="M12 2 2 7l10 5 10-5-10-5ZM2 17l10 5 10-5M2 12l10 5 10-5"/><circle cx="12" cy="12" r="2" fill="currentColor"/>',
  },
  {
    key: 'free',
    slug: 'sky-recognition',
    gradient: 'from-[var(--nitrogen-cyan)] to-[var(--oxygen-blue)]',
    icon: '<path d="M4 8V4h4M16 4h4v4M20 16v4h-4M8 20H4v-4"/><path d="m8 15 2.5-3 2 2 1.5-2 2 3H8Z"/><circle cx="9" cy="9" r="1" fill="currentColor"/>',
  },
  {
    key: 'aurora',
    slug: 'aurora-forecast',
    gradient: 'from-[var(--oxygen-blue)] to-[var(--carbon-purple)]',
    icon: '<path d="M3 17c3-8 6 4 9-5s6 3 9-5M3 21c3-6 6 3 9-4s6 2 9-4"/><path d="M5 4h.01M12 2h.01M19 4h.01"/>',
  },
  {
    key: 'solar',
    slug: '3d-moon',
    gradient: 'from-[var(--sulfur-gold)] to-[var(--oxygen-blue)]',
    icon: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>',
  },
  {
    key: 'meteor',
    slug: 'meteor-shower-calendar',
    gradient: 'from-[var(--sulfur-gold)] to-[var(--hydrogen-pink)]',
    icon: '<path d="m14 4-2.2 4.8L7 11l4.8 2.2L14 18l2.2-4.8L21 11l-4.8-2.2L14 4Z"/><path d="M3 4h5M2 8h6M4 12h3"/>',
  },
  {
    key: 'tools',
    slug: 'astrophotography-tools',
    gradient: 'from-[var(--hydrogen-pink)] to-[var(--sulfur-gold)]',
    icon: '<circle cx="12" cy="12" r="3"/><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>',
  },
] as const;
---

<section class="home-section home-features overflow-hidden px-6" id="features" aria-labelledby="home-features-title" data-motion-section>
  <div class="home-features-glow" aria-hidden="true"></div>
  <div class="relative z-10 mx-auto max-w-7xl">
    <header class="home-section-header" data-motion-header>
      <div class="home-features-eyebrow">{t.features.eyebrow}</div>
      <h2 id="home-features-title">{t.features.title}</h2>
      <p class="text-[var(--text-secondary)]">
        {t.features.subtitle}
      </p>
    </header>

    <div class="home-feature-grid hidden lg:grid" data-motion-group>
      {features.map((feature) => (
        <a
          href={featureHref(feature.slug)}
          class="home-feature-card glass-card group relative overflow-hidden no-underline"
          data-feature={feature.slug}
          data-placement="home-grid"
          data-motion-item
        >
          <span class="relative z-10 block">
            <span class={`home-feature-icon mb-5 flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br ${feature.gradient} shadow-lg transition-transform duration-300 group-hover:-translate-y-1`}>
              <svg class="h-8 w-8 text-white" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={feature.icon}></svg>
            </span>
            <strong class="home-feature-title mb-2 block text-lg text-white transition-colors duration-300 group-hover:text-[var(--nitrogen-cyan)]">
              {t.features[feature.key].title}
            </strong>
            <span class="home-feature-description block text-sm leading-relaxed text-[var(--text-secondary)]">
              {t.features[feature.key].description}
            </span>
          </span>
        </a>
      ))}
    </div>

    <div class="home-feature-mobile no-scrollbar -mx-6 grid snap-x snap-mandatory grid-flow-col grid-rows-2 gap-4 overflow-x-auto px-6 pb-6 lg:hidden" data-motion-group>
      {features.map((feature) => (
        <a
          href={featureHref(feature.slug)}
          class="home-feature-mobile-card glass-card group relative flex h-full w-[76vw] snap-start items-center overflow-hidden p-5 no-underline sm:w-[320px]"
          data-feature={feature.slug}
          data-placement="home-grid-mobile"
          data-motion-item
        >
          <span class="relative flex items-start gap-4">
            <span class={`flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-gradient-to-br ${feature.gradient} shadow-lg`}>
              <svg class="h-6 w-6 text-white" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={feature.icon}></svg>
            </span>
            <span>
              <strong class="mb-1 block text-base leading-tight text-white">{t.features[feature.key].title}</strong>
              <span class="line-clamp-2 block text-xs leading-relaxed text-[var(--text-secondary)]">{t.features[feature.key].description}</span>
            </span>
          </span>
        </a>
      ))}
    </div>

    <div class="home-stat-strip" data-motion-panel>
      {Object.values(t.features.stats || {}).map((stat: any) => (
        <div class="home-stat">
          <strong>{stat.value}</strong>
          <span>{stat.label}</span>
        </div>
      ))}
    </div>

    <div class="home-feature-all" data-motion-item>
      <a href="/features/" data-feature="all" data-placement="home-grid">
        {ui.allFeatures}
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>

<style>
  .home-features {
    padding-block: clamp(5.5rem, 8vw, 7.5rem);
  }

  .home-features::before {
    position: absolute;
    inset: 8% 0 auto;
    height: 32rem;
    background:
      linear-gradient(90deg, transparent, rgb(255 255 255 / 0.045), transparent) top / 100% 1px no-repeat,
      radial-gradient(ellipse 60% 80% at 50% 0%, rgb(34 211 238 / 0.035), transparent 72%);
    content: '';
    pointer-events: none;
  }

  .home-features-glow {
    position: absolute;
    top: 16%;
    right: -14rem;
    width: 30rem;
    height: 30rem;
    border-radius: 50%;
    background: rgb(34 211 238 / 0.065);
    filter: blur(130px);
    pointer-events: none;
  }

  .home-features-eyebrow {
    width: fit-content;
    margin-top: 1rem;
    color: var(--nitrogen-cyan);
    font-size: 0.78rem;
    font-weight: 650;
    letter-spacing: 0.08em;
  }

  .home-features-eyebrow + h2 {
    margin-top: 0.9rem;
  }

  .home-feature-grid {
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1rem;
  }

  .home-feature-card {
    min-height: 13.5rem;
    grid-column: span 4;
    padding: 1.65rem;
    border-color: rgb(255 255 255 / 0.085);
    border-radius: 1.2rem;
    background:
      linear-gradient(150deg, rgb(255 255 255 / 0.05), rgb(255 255 255 / 0.015) 62%),
      rgb(5 5 24 / 0.64);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.065),
      0 20px 60px rgb(0 0 20 / 0.18);
  }

  .home-feature-card:nth-child(-n + 2) {
    min-height: 15.5rem;
    grid-column: span 6;
    padding: 2rem;
  }

  .home-feature-card:hover {
    border-color: rgb(255 255 255 / 0.14);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.09),
      0 24px 66px rgb(7 30 66 / 0.24);
    transform: translateY(-3px);
  }

  .home-feature-card:nth-child(-n + 2) .home-feature-icon {
    width: 3.5rem;
    height: 3.5rem;
  }

  .home-feature-card:nth-child(-n + 2) .home-feature-title {
    max-width: 24rem;
    font-size: 1.35rem;
  }

  .home-feature-card:nth-child(-n + 2) .home-feature-description {
    max-width: 32rem;
    font-size: 0.96rem;
  }

  .home-feature-mobile {
    scroll-padding-inline: 1.5rem;
  }

  .home-feature-mobile-card {
    border-radius: 1.2rem;
    border-color: rgb(255 255 255 / 0.085);
    background: linear-gradient(150deg, rgb(255 255 255 / 0.05), rgb(255 255 255 / 0.018));
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.06);
  }

  .home-stat-strip {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: 1.75rem;
    border-block: 1px solid rgb(255 255 255 / 0.1);
  }

  .home-stat {
    position: relative;
    min-height: 7.25rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 1.6rem;
  }

  .home-stat + .home-stat {
    border-left: 1px solid rgb(255 255 255 / 0.1);
  }

  .home-stat strong {
    color: var(--text-primary);
    font-family: 'Outfit', sans-serif;
    font-size: clamp(1.25rem, 2.2vw, 1.8rem);
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .home-stat > span:last-child {
    margin-top: 0.55rem;
    color: var(--text-muted);
    font-size: 0.72rem;
  }

  .home-feature-all {
    margin-top: 2rem;
    text-align: right;
  }

  .home-feature-all a {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding-bottom: 0.25rem;
    border-bottom: 1px solid rgb(34 211 238 / 0.5);
    color: var(--nitrogen-cyan);
    font-size: 0.84rem;
    font-weight: 650;
    text-decoration: none;
    transition: color 200ms ease, border-color 200ms ease, gap 200ms ease;
  }

  .home-feature-all a:hover {
    gap: 0.9rem;
    border-color: white;
    color: white;
  }

  @media (max-width: 1023px) {
    .home-features {
      padding-block: 4.75rem;
    }
  }

  @media (max-width: 767px) {
    .home-stat-strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .home-stat {
      min-height: 7.5rem;
      padding: 1.15rem;
    }

    .home-stat:nth-child(3) {
      border-left: 0;
    }

    .home-stat:nth-child(n + 3) {
      border-top: 1px solid rgb(255 255 255 / 0.1);
    }
  }
</style>
