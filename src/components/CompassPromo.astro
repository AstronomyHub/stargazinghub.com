---
import { getCompass, compassPath } from '../data/compassContent';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const compass = getCompass(lang);
const label = compass.title.split(/[:：·]/)[0]?.trim() || compass.title;
---

<section class="px-6 py-10">
  <div class="mx-auto max-w-5xl">
    <a href={compassPath(lang)} class="glass-card group flex items-center gap-5 p-6 no-underline md:p-7">
      <img
        src="/compass/icon.png"
        alt=""
        width="64"
        height="64"
        loading="lazy"
        class="h-16 w-16 shrink-0 rounded-2xl shadow-[0_8px_24px_rgba(255,194,75,0.18)]"
      />
      <span class="min-w-0 flex-1">
        <span class="text-xs font-medium text-[var(--sulfur-gold)]">{compass.eyebrow}</span>
        <strong class="mt-0.5 mb-1 block text-lg text-white md:text-xl">{label}</strong>
        <span class="block text-sm leading-relaxed text-[var(--text-muted)]">{compass.subtitle}</span>
      </span>
      <span class="shrink-0 text-2xl text-[var(--text-muted)] transition-transform group-hover:translate-x-1 group-hover:text-[var(--hydrogen-pink)]" aria-hidden="true">→</span>
    </a>
  </div>
</section>
