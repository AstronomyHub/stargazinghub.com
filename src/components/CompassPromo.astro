---
import { getCompass, compassPath } from '../data/compassContent';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const compass = getCompass(lang);
const label = compass.title.split(/[:：·]/)[0]?.trim() || compass.title;
---

<section class="home-compass home-section px-6" data-motion-section>
  <div class="mx-auto max-w-7xl">
    <a href={compassPath(lang)} class="home-compass-card group no-underline" data-motion-panel>
      <img
        src="/compass/icon.png"
        alt=""
        width="64"
        height="64"
        loading="lazy"
        class="home-compass-icon h-16 w-16 shrink-0 rounded-2xl"
        data-motion-item
      />
      <span class="home-compass-copy min-w-0 flex-1" data-motion-item>
        <span class="home-compass-eyebrow">{compass.eyebrow}</span>
        <strong>{label}</strong>
        <span>{compass.subtitle}</span>
      </span>
      <span class="home-compass-arrow" aria-hidden="true" data-motion-item>↗</span>
    </a>
  </div>
</section>

<style>
  .home-compass {
    padding-block: 0 clamp(4.75rem, 7vw, 6.5rem);
  }

  .home-compass-card {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 1.5rem;
    align-items: center;
    overflow: hidden;
    padding: 2rem 2.25rem;
    border: 1px solid rgb(255 255 255 / 0.11);
    border-radius: 1.5rem;
    background: linear-gradient(110deg, rgb(255 230 109 / 0.045), rgb(255 255 255 / 0.022) 38%, rgb(255 255 255 / 0.012));
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.065),
      0 20px 60px rgb(0 0 20 / 0.16);
    transition: border-color 240ms ease, background 240ms ease, transform 240ms ease;
  }

  .home-compass-card::before {
    position: absolute;
    inset: 0 auto 0 0;
    width: 2px;
    background: linear-gradient(180deg, transparent, var(--sulfur-gold), transparent);
    content: '';
    opacity: 0.7;
  }

  .home-compass-card:hover {
    border-color: rgb(255 230 109 / 0.28);
    transform: translateY(-2px);
  }

  .home-compass-icon {
    box-shadow:
      0 14px 38px rgb(255 194 75 / 0.2),
      0 0 0 1px rgb(255 255 255 / 0.11);
  }

  .home-compass-copy {
    display: flex;
    flex-direction: column;
  }

  .home-compass-eyebrow {
    color: var(--sulfur-gold);
    font-size: 0.7rem;
    font-weight: 650;
    letter-spacing: 0.08em;
  }

  .home-compass-copy strong {
    margin-top: 0.3rem;
    color: white;
    font-family: 'Outfit', sans-serif;
    font-size: clamp(1.35rem, 2vw, 1.75rem);
    letter-spacing: -0.025em;
  }

  .home-compass-copy > span:last-child {
    max-width: 48rem;
    margin-top: 0.35rem;
    color: var(--text-muted);
    font-size: 0.86rem;
    line-height: 1.6;
  }

  .home-compass-arrow {
    width: 3rem;
    height: 3rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 50%;
    color: var(--text-secondary);
    font-size: 1.1rem;
    transition: border-color 220ms ease, color 220ms ease, transform 220ms ease;
  }

  .home-compass-card:hover .home-compass-arrow {
    border-color: rgb(255 230 109 / 0.42);
    color: var(--sulfur-gold);
    transform: translate(2px, -2px);
  }

  @media (max-width: 640px) {
    .home-compass {
      padding-bottom: 3.75rem;
    }

    .home-compass-card {
      grid-template-columns: auto minmax(0, 1fr);
      gap: 1rem;
      padding: 1.5rem 1.25rem;
      border-radius: 1.25rem;
    }

    .home-compass-icon {
      width: 3.5rem;
      height: 3.5rem;
    }

    .home-compass-arrow {
      display: none;
    }
  }
</style>
