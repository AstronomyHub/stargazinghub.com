---
interface Props {
  currentLang?: string;
  paths?: Record<string, string>;
}

const { currentLang = 'en', paths } = Astro.props;
---

<aside
  id="language-suggestion"
  class="language-suggestion"
  data-current-lang={currentLang}
  data-language-paths={paths ? JSON.stringify(paths) : undefined}
  hidden
  role="dialog"
  aria-modal="false"
  aria-labelledby="language-suggestion-title"
  aria-describedby="language-suggestion-message"
>
  <div class="language-suggestion__copy">
    <span class="language-suggestion__mark" aria-hidden="true">A/文</span>
    <div>
      <h2 id="language-suggestion-title">Language available</h2>
      <p id="language-suggestion-message">This website is available in your browser language.</p>
    </div>
  </div>
  <div class="language-suggestion__actions">
    <button id="language-suggestion-dismiss" type="button">Stay here</button>
    <button id="language-suggestion-confirm" type="button">Switch language</button>
  </div>
</aside>

<style>
  .language-suggestion {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 100;
    width: min(28rem, calc(100vw - 2rem));
    padding: 1rem;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 0.9rem;
    background: rgb(16 30 41 / 0.97);
    color: #fff;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.055),
      0 1.25rem 4rem rgb(0 8 30 / 0.38);
    backdrop-filter: blur(20px);
  }

  .language-suggestion[hidden] {
    display: none;
  }

  .language-suggestion__copy {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .language-suggestion__mark {
    flex: none;
    padding: 0.3rem 0.45rem;
    border: 1px solid rgb(201 223 200 / 0.24);
    border-radius: 0.5rem;
    background: rgb(201 223 200 / 0.07);
    color: #c9dfc8;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.02em;
  }

  .language-suggestion h2 {
    margin: 0;
    color: #fff;
    font-size: 0.95rem;
    font-weight: 750;
    line-height: 1.3;
  }

  .language-suggestion p {
    margin: 0.25rem 0 0;
    color: rgb(255 255 255 / 0.7);
    font-size: 0.8rem;
    line-height: 1.45;
  }

  .language-suggestion__actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
    margin-top: 0.85rem;
  }

  .language-suggestion button {
    min-height: 44px;
    padding: 0.65rem 0.75rem;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 0.7rem;
    background: rgb(255 255 255 / 0.035);
    color: #fff;
    font: inherit;
    font-size: 0.82rem;
    font-weight: 700;
    cursor: pointer;
    transition: border-color 180ms ease, background-color 180ms ease, color 180ms ease, transform 180ms ease;
  }

  .language-suggestion button:hover {
    border-color: rgb(255 255 255 / 0.2);
    background: rgb(255 255 255 / 0.07);
  }

  .language-suggestion button:active {
    transform: translateY(1px);
  }

  #language-suggestion-confirm {
    border-color: #c9dfc8;
    background: #c9dfc8;
    color: #07151e;
  }

  #language-suggestion-confirm:hover {
    border-color: #e0ecdc;
    background: #e0ecdc;
  }

  @media (max-width: 639px) {
    .language-suggestion {
      right: 0.75rem;
      bottom: 0.75rem;
      left: 0.75rem;
      width: auto;
    }
  }
</style>

<script is:inline>
  (() => {
    const suggestion = document.getElementById('language-suggestion');
    if (!(suggestion instanceof HTMLElement)) return;

    const locales = {
      en: {
        url: '/',
        title: 'English version available',
        message: 'Your browser uses English. Would you like to switch?',
        confirm: 'Switch to English',
        dismiss: 'Stay here',
      },
      zh: {
        url: '/zh/',
        title: '可以切换到简体中文',
        message: '检测到浏览器使用简体中文，是否切换？',
        confirm: '切换到简体中文',
        dismiss: '留在当前页面',
      },
      'zh-tw': {
        url: '/zh-tw/',
        title: '可以切換到繁體中文',
        message: '偵測到瀏覽器使用繁體中文，是否切換？',
        confirm: '切換到繁體中文',
        dismiss: '留在目前頁面',
      },
      de: {
        url: '/de/',
        title: 'Deutsche Version verfügbar',
        message: 'Ihr Browser verwendet Deutsch. Möchten Sie wechseln?',
        confirm: 'Zu Deutsch wechseln',
        dismiss: 'Hier bleiben',
      },
      es: {
        url: '/es/',
        title: 'Versión en español disponible',
        message: 'Tu navegador usa español. ¿Quieres cambiar de idioma?',
        confirm: 'Cambiar a español',
        dismiss: 'Permanecer aquí',
      },
      fr: {
        url: '/fr/',
        title: 'Version française disponible',
        message: 'Votre navigateur utilise le français. Voulez-vous changer de langue ?',
        confirm: 'Passer au français',
        dismiss: 'Rester ici',
      },
      it: {
        url: '/it/',
        title: 'Versione italiana disponibile',
        message: 'Il browser usa l’italiano. Vuoi cambiare lingua?',
        confirm: 'Passa all’italiano',
        dismiss: 'Resta qui',
      },
      ja: {
        url: '/ja/',
        title: '日本語版をご利用いただけます',
        message: 'ブラウザの言語は日本語です。切り替えますか？',
        confirm: '日本語に切り替える',
        dismiss: 'このまま見る',
      },
      ko: {
        url: '/ko/',
        title: '한국어 버전을 사용할 수 있습니다',
        message: '브라우저 언어가 한국어입니다. 전환할까요?',
        confirm: '한국어로 전환',
        dismiss: '현재 페이지 유지',
      },
      nl: {
        url: '/nl/',
        title: 'Nederlandse versie beschikbaar',
        message: 'Je browser gebruikt Nederlands. Wil je overschakelen?',
        confirm: 'Naar Nederlands',
        dismiss: 'Hier blijven',
      },
      pl: {
        url: '/pl/',
        title: 'Dostępna jest polska wersja',
        message: 'Twoja przeglądarka używa języka polskiego. Przełączyć?',
        confirm: 'Przełącz na polski',
        dismiss: 'Zostań tutaj',
      },
      ru: {
        url: '/ru/',
        title: 'Доступна русская версия',
        message: 'Язык браузера: русский. Переключить сайт?',
        confirm: 'Перейти на русский',
        dismiss: 'Остаться здесь',
      },
    };

    const normalizeLanguage = (language) => {
      const normalized = String(language || '').toLowerCase();
      if (!normalized) return null;
      if (/^zh-(tw|hk|mo)/.test(normalized) || normalized.includes('hant')) return 'zh-tw';
      if (normalized.startsWith('zh')) return 'zh';
      const primary = normalized.split('-')[0];
      return Object.prototype.hasOwnProperty.call(locales, primary) ? primary : null;
    };

    const readPreference = () => {
      try {
        return window.localStorage.getItem('preferred_path');
      } catch {
        return null;
      }
    };

    const writePreference = (path) => {
      try {
        window.localStorage.setItem('preferred_path', path);
      } catch {
        // The prompt still works when storage is unavailable.
      }
    };

    if (readPreference()) return;

    const browserLanguages = Array.isArray(navigator.languages) && navigator.languages.length
      ? navigator.languages
      : [navigator.language];
    const targetKey = browserLanguages.map(normalizeLanguage).find(Boolean);
    const currentKey = suggestion.dataset.currentLang || 'en';
    if (!targetKey || targetKey === currentKey) return;

    const target = locales[targetKey];
    if (!target) return;
    const paths = suggestion.dataset.languagePaths ? JSON.parse(suggestion.dataset.languagePaths) : null;
    const destination = paths ? paths[targetKey] : target.url;
    if (!destination) return;

    const dismissalKey = `language_prompt_dismissed:${currentKey}:${destination}`;
    try {
      if (window.sessionStorage.getItem(dismissalKey)) return;
    } catch {
      // Session storage is optional.
    }

    const title = document.getElementById('language-suggestion-title');
    const message = document.getElementById('language-suggestion-message');
    const confirm = document.getElementById('language-suggestion-confirm');
    const dismiss = document.getElementById('language-suggestion-dismiss');
    if (!(title && message && confirm instanceof HTMLButtonElement && dismiss instanceof HTMLButtonElement)) return;

    title.textContent = target.title;
    message.textContent = target.message;
    confirm.textContent = target.confirm;
    dismiss.textContent = target.dismiss;

    const reveal = () => {
      suggestion.hidden = false;
    };
    if ('requestIdleCallback' in window) {
      window.requestIdleCallback(reveal, { timeout: 1400 });
    } else {
      window.setTimeout(reveal, 900);
    }

    confirm.addEventListener('click', () => {
      writePreference(target.url);
      window.location.assign(destination);
    });

    dismiss.addEventListener('click', () => {
      suggestion.hidden = true;
      try {
        window.sessionStorage.setItem(dismissalKey, '1');
      } catch {
        // Dismissing still hides the prompt when storage is unavailable.
      }
    });
  })();
</script>
